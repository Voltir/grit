#!/usr/bin/env bash
# The tui gate: grit.tui.examples.Demo driven through a real pty with scripted mouse bytes, and
# the painted result checked against the selection model.
#
# One scenario per failure, because no one of them can fail the way the others can:
#
#   span   a drag that autoscrolls past the top of the pane, so the selection is larger
#          than the screen. What is highlighted must be a prefix of what was copied --
#          the visible part of a selection that continues off-screen.
#   one    a drag that stays on one screen, so the whole selection is visible and the
#          highlighted cells must equal the clipboard exactly.
#   modal  a drag begun in the modal and finished over the transcript -- the clipboard
#          must be a slice of the modal's own document (rule 6) -- and then a second
#          drag made entirely outside the modal, which must copy nothing at all. The
#          first alone does not pin the modal's routing: a press that is inside both the
#          modal and the transcript behind it takes the same path either way. Only a
#          press the modal has to swallow says which rect it was routed against.
#   resize the pty is resized under the running app (a real SIGWINCH, via TIOCSWINSZ on
#          its own pts). The frames after it must be painted to the new size.
#   popup  the keyboard path, which every other scenario leaves untouched: Tab opens the
#          completion list, Down moves the selection, Enter takes it into the prompt, and
#          a second Enter submits it. The chosen command must *run* -- that is what makes
#          this an oracle for the slash table rather than for the popup's painting, and
#          both halves used to be uncovered: the popup's routing moved into the Std layer
#          and `/help` had silently drifted from alt-m with nothing to notice.
#   thumb  the scrollbar thumb is pressed and dragged upward: the thumb must move, the
#          transcript must scroll with it, and neither a selection nor a clipboard write
#          may result -- the widget drag is not a text drag (widget identity).
#   burst  a line typed in one write, so the loop routes a batch of keys before it
#          repaints. The prompt must hold all of it: each key builds on the previous
#          key's result, not on the last paint (the view tree's stale-handler bug).
#
# Byte-level checks ride along on every run: modes balanced, no bare LF, nothing written
# into the last column, the frame never scrolls.
#
#   chat   grit.app itself, with the stub model: a message typed and submitted is painted
#          with its reply, and the prompt clears. Needs the compose Postgres running.
#   reload a second grit.app run in the same conversation paints that exchange with no
#          input: the transcript is loaded from the store. Runs after `chat`.
#   columns grit.app wide enough for the turn panel, in a conversation of its own: the
#          wheel over each column scrolls only that column, a drag begun in the
#          transcript stays in it however far into the panel it runs, and the prompt
#          still takes keys.
#   stream grit.app with a slow stub, in a conversation of its own: the reply is painted
#          part-written while the model is still answering, and the recorded reply
#          replaces it, once.
#   turn-modal grit.app with a slow stub, in a conversation of its own: a click on the
#          thinking line opens the running turn over the screen, which takes the keys
#          until Escape closes it; a click on an earlier reply pins its turn to the panel,
#          and Escape lets it go.
#   palette grit.app's command palette, in a conversation of its own: `/` opens the list,
#          typing filters it, Enter on /theme offers the themes, Enter on one repaints the
#          screen in it and closes the list, and a list opened again is dismissed by
#          Escape. Nothing typed here may reach the transcript: a `/` draft is a command.
#
# Usage: scripts/tui-gate [span|one|modal|thumb|popup|resize|burst|chat|reload|columns|turn-modal|palette|stream]
#        (no argument runs them all; `reload` needs `chat` before it in the same run)
#
# The oracles are geometry, not implementation: the chrome is header 1 + prompt 3 +
# status 1, the scrollbar is the body's last column, and the modal's document is HELP.
#
# Ported from ../Spikes/tui-spike-slate (`./gate` there). The scenarios before `chat` drive
# Demo, which exercises library features grit.app does not use yet (the modal, the popup,
# the scrollbar thumb); `chat` and `reload` drive grit.app. MAIN names another example to
# drive instead.
set -u
cd "$(dirname "$0")/.."

MAIN=${MAIN:-grit.tui.examples.Demo}

ROWS=30
COLS=100
WORK=${TMPDIR:-/tmp}/grit-tui-gate
mkdir -p "$WORK"

JAVA_OPTS= ./mill grit.tui.examples.compile grit.app.compile > "$WORK/compile.log" 2>&1 || { cat "$WORK/compile.log"; exit 1; }
classpath() {
  JAVA_OPTS= ./mill show "$1" 2>/dev/null |
    grep -oP '"q?ref:v[01]:[0-9a-f]+:\K[^"]+' | tr '\n' ':' | sed 's/:$//'
}
CP=$(classpath grit.tui.examples.runClasspath)
APP_CP=$(classpath grit.app.runClasspath)
J=${GRIT_JDK_HOME:-/home/nickchilders/.jdks/jdk-26.0.2}
# Every JVM this script forks carries a stamp on its command line, and teardown kills
# only processes carrying *this* stamp. A blanket `pkill -f Demo` also kills the
# copy the developer is playing with in another window -- which is exactly what it did
# the first time this script existed.
STAMP="gate-$$-$(date +%s)"
RUNNER="$J/bin/java --sun-misc-unsafe-memory-access=allow --enable-native-access=ALL-UNNAMED -cp $CP $MAIN --$STAMP"

# grit.app takes no stamp argument (any argument puts Main in one-shot mode), so the stamp
# rides in a system property whose value carries it. The stub model: no .env, no key. A
# conversation of the gate's own, so `reload` sees exactly what `chat` wrote.
# And a database that is not Nick's: an engine launched on `grit` would recover his
# in-flight turns (CLAUDE.local.md). Created on first use. GRIT_GATE_DB names another,
# for a second agent whose engines must not recover this one's turns.
AGENT_DB=${GRIT_GATE_DB:-grit_agent}
APP_RUNNER="env -u OPENROUTER_API_KEY GRIT_ENV_FILE=/dev/null GRIT_SESSION=$STAMP GRIT_LOG=$WORK/grit.log \
  GRIT_DATABASE_URL=jdbc:postgresql://localhost:5432/$AGENT_DB \
  $J/bin/java -Dgate.stamp=--$STAMP --sun-misc-unsafe-memory-access=allow --enable-native-access=ALL-UNNAMED \
  -cp $APP_CP grit.app.main.Main"

E=$'\033'

# A no-daemon JVM still has to start; scripting input before the app is listening loses it.
STARTUP=3
# grit.app paints at once and opens DBOS behind a ward; typing waits for the engine.
APP_STARTUP=12

script_span() {
  sleep $STARTUP
  printf "%s" "${E}[<0;11;21M"
  for r in 18 15 12 9 6 4 2; do sleep 0.15; printf "%s" "${E}[<32;30;${r}M"; done
  # Parked above the pane, at its *left* edge: autoscroll pulls screens in, and the
  # head lands at column 0 of whatever row arrives at the top. Parking further right
  # made "the highlight fills the pane" quietly depend on the top row being that wide --
  # a short line there clamps the head to its end and highlights nothing, which is
  # correct behaviour failing an oracle that meant to ask something else.
  printf "%s" "${E}[<32;1;1M"
  sleep 2.5
  printf "%s" "${E}[<0;1;1m"
  sleep 0.6; printf '\021'; sleep 1
}

script_one() {
  sleep $STARTUP
  printf "%s" "${E}[<0;11;6M"
  for c in 20 40 60 80; do sleep 0.1; printf "%s" "${E}[<32;${c};9M"; done
  sleep 0.1; printf "%s" "${E}[<32;35;12M"
  sleep 0.3; printf "%s" "${E}[<0;35;12m"
  sleep 0.6; printf '\021'; sleep 1
}

script_modal() {
  sleep $STARTUP
  printf "%s" "${E}m"; sleep 0.4
  printf "%s" "${E}[<0;31;12M"
  sleep 0.2; printf "%s" "${E}[<32;60;15M"
  sleep 0.2; printf "%s" "${E}[<32;91;26M"   # out of the modal, over the transcript
  sleep 0.4; printf "%s" "${E}[<0;91;26m"
  # A whole drag behind the open modal: pressed, dragged and released on the transcript
  # with the dialog still up. The modal swallows it, so nothing is selected and nothing
  # is copied -- there must still be exactly one clipboard write from the drag above.
  sleep 0.4; printf "%s" "${E}[<0;20;24M"
  sleep 0.2; printf "%s" "${E}[<32;70;26M"
  sleep 0.3; printf "%s" "${E}[<0;70;26m"
  sleep 0.6; printf '\021'; sleep 1
}

# The keyboard: Tab, Down, Enter, Enter. Nothing here is a mouse report, which is why
# it fails differently from every scenario above it.
script_popup() {
  sleep $STARTUP
  printf '\t'; sleep 0.5            # Tab: the completion list, selection on /help
  printf "%s" "${E}[B"; sleep 0.5   # Down: /stream
  printf '\r'; sleep 0.5            # Enter: chosen, and the list closes
  printf '\r'; sleep 0.8            # Enter: submitted -- /stream pauses the streamer
  printf '\021'; sleep 1
}

script_thumb() {
  sleep $STARTUP
  printf "%s" "${E}[<0;99;25M"   # press on the thumb, near the bottom of the track
  sleep 0.4
  printf "%s" "${E}[<32;99;6M"   # drag it up
  sleep 0.5
  printf "%s" "${E}[<0;99;6m"    # release: no copy, no selection
  sleep 0.6; printf '\021'; sleep 1
}

# A real SIGWINCH: set the window size on the app's own pty and let the kernel signal it.
script_resize() {
  (
    sleep $((STARTUP + 2))
    # Match the JVM itself, not every shell whose command line mentions the demo -- the
    # same trap as the pkill in CLAUDE.md, and here it picks a pid whose stdin is
    # /dev/null and the resize silently does nothing.
    pid=$(pgrep -f -- "--$STAMP" | tail -1)
    pts=$(readlink "/proc/$pid/fd/0" 2>/dev/null)
    case "$pts" in
      /dev/pts/*) ;;
      *) echo "gate: could not find the app's pty (pid=$pid pts=$pts)" >&2 ;;
    esac
    python3 -c "import fcntl,struct,sys,termios
f=open(sys.argv[1],'wb')
fcntl.ioctl(f, termios.TIOCSWINSZ, struct.pack('HHHH', 20, 60, 0, 0))" "$pts"
  ) &
  sleep $((STARTUP + 4))
  printf '\021'
  sleep 1
}

script_burst() {
  sleep $STARTUP
  printf 'gate says hi'; sleep 0.8
  printf '\021'; sleep 1
}

script_chat() {
  sleep $APP_STARTUP
  printf 'gate says hi'; sleep 0.4
  printf '\r'; sleep 4
  printf '\021'; sleep 2
}

# Short and wide: the panel shows (the app gets COLS - 1 >= 100 columns) and five
# exchanges overflow both panes. The panel is the last 38 columns before the screen's
# own unwritten last one; x=100 is inside it, x=20 inside the transcript.
COLUMNS_ROWS=16
COLUMNS_COLS=120
script_columns() {
  sleep $APP_STARTUP
  for n in one two three four five; do
    printf 'message %s' "$n"; sleep 0.3; printf '\r'; sleep 2.5
  done
  sleep 1
  for _ in 1 2; do printf "%s" "${E}[<65;100;6M"; sleep 0.3; done   # wheel down, panel
  sleep 0.8
  for _ in 1 2; do printf "%s" "${E}[<64;20;6M"; sleep 0.3; done    # wheel up, transcript
  sleep 0.8
  printf "%s" "${E}[<0;5;3M"                                         # press in the transcript
  for c in 30 60 90 105; do sleep 0.1; printf "%s" "${E}[<32;${c};8M"; done  # into the panel
  sleep 0.3; printf "%s" "${E}[<0;105;8m"
  sleep 0.8; printf 'still here'; sleep 0.8
  printf '\021'; sleep 2
}

# The transcript fills from the top: header row 1, then (1-based) the rule, "first",
# its reply, the rule, "second", and the thinking line on row 7 while the slow stub
# (6s) answers it.
MODAL_ROWS=24
MODAL_COLS=120
script_turn-modal() {
  sleep $APP_STARTUP
  printf 'first'; sleep 0.3; printf '\r'; sleep 8
  printf 'second'; sleep 0.3; printf '\r'; sleep 1.5
  printf "%s" "${E}[<0;8;7M"; sleep 0.1; printf "%s" "${E}[<0;8;7m"   # click the thinking line
  sleep 0.8; printf 'x'; sleep 0.5                                      # the dialog takes it
  printf '\033'; sleep 0.8                                              # Escape closes
  printf "%s" "${E}[<0;10;4M"; sleep 0.1; printf "%s" "${E}[<0;10;4m" # click first's reply
  sleep 1.2; printf '\033'; sleep 1.2                                   # Escape: the latest
  printf '\021'; sleep 2
}

PALETTE_ROWS=30
PALETTE_COLS=110
script_palette() {
  sleep $APP_STARTUP
  printf '/'; sleep 0.8                 # the list, every command
  printf 'th'; sleep 0.8                # filtered to /theme
  printf '\r'; sleep 0.8                # chosen: the themes, as a second list
  printf 'tokyo-n'; sleep 0.8           # filtered to tokyo-night
  printf '\r'; sleep 1.2                # chosen: the screen repaints, the list closes
  printf '/'; sleep 0.8                 # open again
  printf '\033'; sleep 1.2              # Escape dismisses it
  printf '\021'; sleep 2
}

script_stream() {
  sleep $APP_STARTUP
  printf 'rune one two three four five six seven eight nine ten eleven twelve'
  sleep 0.3; printf '\r'; sleep 9
  printf '\021'; sleep 2
}

script_reload() {
  sleep $((APP_STARTUP + 2))
  printf '\021'; sleep 2
}

run_one() {
  # A scenario with no script would run with no input and never quit.
  declare -F "script_$1" > /dev/null || { echo "gate: no scenario $1" >&2; return 1; }
  local name=$1 out="$WORK/$1.txt" runner=$RUNNER rows=$ROWS cols=$COLS
  case "$name" in chat|reload) runner=$APP_RUNNER ;; esac
  if [ "$name" = columns ]; then
    runner=${APP_RUNNER/GRIT_SESSION=$STAMP/GRIT_SESSION=$STAMP-columns}
    rows=$COLUMNS_ROWS cols=$COLUMNS_COLS
  fi
  if [ "$name" = stream ]; then
    runner=${APP_RUNNER/GRIT_SESSION=$STAMP/GRIT_STUB_DELAY_MS=5000 GRIT_SESSION=$STAMP-stream}
  fi
  if [ "$name" = turn-modal ]; then
    runner=${APP_RUNNER/GRIT_SESSION=$STAMP/GRIT_STUB_DELAY_MS=6000 GRIT_SESSION=$STAMP-modal}
    rows=$MODAL_ROWS cols=$MODAL_COLS
  fi
  if [ "$name" = palette ]; then
    runner=${APP_RUNNER/GRIT_SESSION=$STAMP/GRIT_SESSION=$STAMP-palette}
    rows=$PALETTE_ROWS cols=$PALETTE_COLS
  fi
  "script_$name" | setsid script -qc "stty rows $rows cols $cols; $runner" /dev/null > "$out" 2>&1
  python3 scripts/tui-gate.py "$out" "$rows" "$cols" "$name"
}

ensure_agent_db() {
  docker compose exec -T postgres psql -U grit -d grit -tAc \
    "SELECT 1 FROM pg_database WHERE datname = '$AGENT_DB'" | grep -q 1 ||
    docker compose exec -T postgres createdb -U grit "$AGENT_DB"
}

case " ${*:-chat} " in
  *" chat "*|*" reload "*|*" columns "*|*" turn-modal "*|*" palette "*|*" stream "*) ensure_agent_db || { echo "gate: Postgres is not up (docker compose up -d postgres)" >&2; exit 1; } ;;
esac

case " ${1:-} " in
  *" reload "*) case " $* " in *" chat "*) ;; *)
    echo "gate: reload needs chat before it in the same run: scripts/tui-gate chat reload" >&2
    exit 2 ;; esac ;;
esac

status=0
for s in ${*:-span one modal thumb popup resize burst chat reload columns turn-modal palette stream}; do
  echo "== $s"
  run_one "$s" || status=1
done

# A run that ended badly can leave a headless JVM holding ~400MB. -9 because the app
# clears ISIG and ignores SIGTERM in raw mode. Scoped to this run's stamp: never touch a
# demo someone else is using.
pkill -9 -f -- "--$STAMP" 2>/dev/null
exit $status
