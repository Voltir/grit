#!/usr/bin/env bash
# Every Scala source under a module's src checked by the pinned native scalafmt (tools/scalafmt;
# bash scripts/fetch-scalafmt.sh installs it), with .scalafmt.conf: exits non-zero when one is
# not formatted, or when scalafmt cannot parse one, naming each such file. scalafmt reports an
# unparseable file as `<path>:<line>: error: …`, skips it and still exits 0, so this reads its
# output for them. Reformat with ./mill mill.scalalib.scalafmt.ScalafmtModule/reformatAll
# __.sources, which reads the same configuration and version.
#
#   scripts/format-check                       # as scripts/check's format tier runs it
set -uo pipefail

cd "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

scalafmt=tools/scalafmt
[ -x "$scalafmt" ] || { echo "format: no $scalafmt -- run: bash scripts/fetch-scalafmt.sh" >&2; exit 1; }

mapfile -t files < <(find core extensions kit deployments eval dev -path '*/out' -prune -o \
  -path '*/src/*' -name '*.scala' -print | sort)
log=$("$scalafmt" --test --non-interactive --respect-project-filters --config .scalafmt.conf "${files[@]}" 2>&1)
rc=$?
mapfile -t skipped < <(grep -oE '^[^ ]+\.scala:[0-9]+: error:' <<<"$log" | sed -E 's/:[0-9]+: error:$//' | sort -u)
for f in "${skipped[@]}"; do
  echo "format: ${f#"$PWD"/} does not parse; scalafmt skipped it"
done
# --test prints each misformatted file's diff, headed `--- a<path>`; it fails on them itself.
grep -E '^--- a' <<<"$log" | sed -E 's#^--- a##' | sort -u | while read -r f; do
  echo "format: ${f#"$PWD"/} is not formatted; run reformatAll"
done
echo "format: ${#files[@]} files checked"
[ ${#skipped[@]} -eq 0 ] || exit 1
exit "$rc"
