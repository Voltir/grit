#!/usr/bin/env bash
# The eval harness (eval/harness/README.md), run with mill out of the loop: mill builds the
# launcher and exits, then java runs the harness directly.
#
# Every price is shown in millidollars, written m$ (m$1 is $0.001); --spend caps are given
# in USD.
#
#   scripts/eval capture --from <database> [--date <yyyymmdd>]
#       A capture of <database>'s heard messages, in .local/eval/capture/<date>/ (date: today,
#       UTC). The first run dumps <database> (pg_dump -Fc, an MVCC read beside a running
#       engine: source.dump, and its sha256 and time in dump.txt, written once it is restored) and restores it to
#       grit_eval_<date>, which must not exist yet; a later run reuses both. Each run then
#       writes capture.json and cases.jsonl, turns.jsonl (every turn the database recorded,
#       TUI and Slack, by workflow: its offer and the shape its recipe decided, what its
#       weigh step recorded, its window by part and the documents it held, rounds, ending, spend
#       and draft's outcome; a capture of an older format is refused by every command reading
#       it until recaptured) and verdicts.json (the review verdicts standing), all text-free, and
#       prints counts. Rerun over the same
#       restored database by the same build, it writes the same bytes. A failed restore's
#       errors, which can quote rows, go to .local/eval/review/restore-<date>.log.
#
#   scripts/eval run --capture <yyyymmdd> --variant <name> --spend <usd> [--repeats n]
#                    [--first n] [--no-cache] [--rule <file>]
#       Every case of the capture rebuilt through the shipped builders from grit_eval_<date>,
#       how its inputs changed from capture printed (ids and counts), then asked of Jev as
#       the variant says (live, durable-lasting, jev-latest, nearby-open, exchanges-open,
#       nearby-author-open, sections-named, nearby-open+named, exchanges-open+named,
#       nearby-author-open+named): each request --repeats times
#       (default 3: Jev's answers vary from call to call), over the first n cases by ts with
#       --first, answered from .local/eval/cache/ unless --no-cache. --spend is a hard cap in
#       USD: the run refuses before any call when its estimate is over it, and skips every
#       call past it. Writes
#       .local/eval/runs/<stamp>-<variant>.jsonl and prints counts and the spend. Jev's key
#       is JEV_API_KEY, from the environment over GRIT_ENV_FILE (the main checkout's .env
#       when unset), read by the harness as grit does.
#
#   scripts/eval determinism --capture <yyyymmdd> --log <runs file>
#       How far apart a run's repeats answered, and how far its answers are from what triage
#       and stitching kept live: the largest gap, and the questions and cases over 1e-9, by
#       id. <runs file> is a name in .local/eval/runs/.
#
#   scripts/eval inputs <yyyymmdd> [--more] [--variant <name>]
#       Every case's questions rebuilt through the shipped builders from grit_eval_<date>,
#       triage's by the variant's recipe (default live, the shipped), and written, text and
#       all, to .local/eval/review/inputs-<date>.jsonl (inputs-<date>-<variant>.jsonl for
#       another variant), a line a case:
#       triage's and stitching's request (the state as the classifier receives it, and the
#       questions' words) and digest, and stitching's state shown live beside it. With
#       --more, triage's line also holds what its thread left out, and where. Prints counts,
#       and how each digest compares to cases.jsonl's: never the file's text.
#
#   scripts/eval context <workflow-id | heard-entry-id> --from <database> [--full] [--capture <yyyymmdd>]
#       One recorded turn as its model was sent it, text and all, written to
#       .local/eval/review/context-<workflow-id>.md for a person to read: how it got there
#       (the stitch placement and the state its classifier saw, triage's tags, the speech
#       decision and its judgement, the queries and window, every ledger row), then each
#       model call's request rebuilt from the turn's recorded inputs (prompt fragments, tool
#       set, pinned profile, window, entries) through this build's code, each call's estimate
#       against its ledger row, the answer and the summary. The epoch the turn ran under is
#       shown beside this build's. Tool results are cut at 4,000 characters unless --full.
#       Reads <database> through read-only sessions; prints counts, never text.
#       Given a heard message's entry id (in:<conversation>:<ts>) instead: what Jev was asked
#       of it and answered, written to .local/eval/review/context-<entry-id>.md: the stitch
#       state as recorded with its placement, its question as this build words it, and
#       triage's request rebuilt through the shipped builder (triage keeps none), its words
#       for the persona and corpora in .local/eval/capture/<yyyymmdd>/ with --capture
#       (persona.json, knowledge.json), else grit and none, beside the tags triage kept.
#
#   scripts/eval score <runs file> [--labels <file>]
#       The run scored, written to .local/eval/reports/<run>.md and printed: text-free, ids
#       and numbers. Labels come from .local/eval/labels.json (or <file>); with none it says
#       "unlabelled: 0 of N cases labelled" and gives what needs no label: spend and latency,
#       the repeats' spread, and agreement with what triage and stitching kept live. Once
#       labels exist: Brier scores, reliability, threshold sweeps and the expected-cost curve
#       over the cost-of-error ratio, all and by the label context (ok, short). Every mean
#       has its 95% interval clustered by exchange, and by author beside it.
#
#   scripts/eval compare <runs file A> <runs file B> [--labels <file>] [--decide <rule>]
#                        [--replica <runs file> --spread <runs file>]
#       Run B against run A, paired on the cases both answered: B - A per question, the
#       cases each question's decision fixed, broke or moved, by id, and once labels exist
#       the paired difference in Brier score with its MDE; and the cases whose triage
#       inputs differ between A and B, by context and focus, B - A over them alone, each
#       run's input tokens and cost per call, and the MDE A's repeat noise implies on them.
#       Written to .local/eval/reports/<A>-vs-<B>.md and printed. With --decide, the
#       adoption rule in <rule> (JSON: {"question": "durable", "metric": "brier", "better":
#       "lower", "least": 0.01}; "question": "mean" for the mean of kind, waiting, durable
#       and helps; optionally "context": "short", "guard": {"context": "ok", "worse_by":
#       0.02} over those four, and "not_worse": {"question": "helps", "worse_by": 0} in the
#       rule's context, each judged on the mean difference) judges B over A, and the exit
#       code says what it decided: 0 adopt B, 3 refused (B was not run with --rule <rule>,
#       the difference is under its MDE or the rule's least, or a guard is broken), 4 keep A. With --replica, a pulled replica shadow's log (the shipped
#       wording, of the live model), A being a live log an earlier build pulled by position
#       (a pull now writes live's under its names, which score and compare refuse): each case whose replica answer
#       stands from live's by more than 10 × Jev's repeat spread on some question (measured as
#       each question's pooled standard deviation in the --spread run, which has repeats) has
#       moved on since live triage asked, and is listed and left out of the comparison.
#
#   scripts/eval compare <runs file A> <runs file B> --live <set> --gate <set>
#                        [--verdicts <verdicts file>]
#       B a question set's shadow log from pull, asking the --gate set, against A, live
#       triage's pulled log, asking the --live set (each v1, v2, v3 or v4; v1 for a live log
#       an earlier build pulled by position; B may be A itself, as v3's gate over v4's live
#       answers, which v4 asks in v3's words): each one's draft by its own set's gate over its
#       answers alone, not live's speech decision, a 2x2 by focus and over all; each of B's
#       probabilities' mean and standard deviation; and B's durable against live's, each at
#       0.5. Counts only, written to .local/eval/reports/<A>-vs-<B>.md and printed; the ids of
#       the cases each decided alone go to
#       .local/eval/order/<yyyymmdd>-draft-<set>-live-only.txt and -set-only.txt, for
#       labelling. With --verdicts (a verdicts-<yyyymmdd>.json pull wrote, a name in
#       .local/eval/runs/), by shadow and the reason each message was picked: how many
#       verdicts on cases both gates decided, how many of them each draft decided as the
#       verdict says (a welcome reply speaks; an interruption or a message meant for someone
#       does not), and how many each side's to >= 0.5 read as the verdict says (meant for
#       someone, or to the room; — for a set that asks no to). Counts only, not weighted back
#       by how often each reason is picked; without --verdicts the report says none were
#       given. Takes no --helps-at (live's gate is its set's), --decide, --replica or
#       --spread.
#
#   scripts/eval order <runs file A> [<runs file B>] [--tag <question>] [--by spread|difference]
#       Case ids in labelling order, one a line, in
#       .local/eval/order/<yyyymmdd>-<question>-<by>.txt, for eval-label's --order: those not
#       yet labelled on <question> (kind, waiting, durable, helps or place; default durable)
#       first, each by the difference between runs A and B on it (the default with B), or by
#       run A's repeat spread on it, Jev's own uncertainty (the default without), largest
#       first. Prints counts.
#
#   scripts/eval pull --from <database> --capture <yyyymmdd> --shadows <name,...> [--since <instant>]
#       What <database> kept of the heard messages tagged since <instant> (default: ever) that
#       the capture holds, as run logs in .local/eval/runs/: live triage's tags as
#       live-<today>.jsonl (variant `kept`), under the names of the question set its first
#       answered row asked, the names in its header; a row of other names (a message triaged
#       before live's question set changed) is left out and counted, so pull with --since the
#       change. Each named shadow's answers as shadow-<name>-<today>.jsonl: a wording's by
#       position, for score, compare and order; a question set's under its questions' names,
#       as live's are, for compare --live --gate. A shadow whose rows are of both (its name
#       declared for a wording and then a set) is refused: no log, its counts printed; declare
#       a changed question under a new name. Only reads <database>. Prints counts: each log's
#       rows, live's questions and its rows left out under other names, and for each shadow
#       the messages tagged since that it has no row for, its shadow ended keeping nothing or
#       not yet run; and the ids of the messages no capture holds yet, for the next capture. Also writes verdicts-<today>.json beside the logs: the verdict a
#       review's rater left standing on each message a review picked since <instant>, by case
#       id, with the shadow it was picked against, why, the rater's id and when; ids and
#       times, no text. A file of none is written when there are none.
#
#   scripts/eval replies <yyyymmdd> (--case <id>... | --pick <n> [--by <order>]) [--records] [--show]
#       A review of the capture's replies for a person to label, written, text and all, to
#       .local/eval/replies/replies-<date>-<stamp>.md (the stamp the time it was written, UTC):
#       at most 5 turns, more refused. --case names turns by workflow id, or by a Slack
#       message's case id (the turn that answered it); --pick chooses n turns not yet in
#       .local/eval/reply-labels.json, --by posted, held, tools, widest or random (the
#       default, its seed written in the file). Each case shows the message its turn answers
#       and its reply; with --records, at most 3 of its window's parts, best supported first,
#       each cut at 800 characters; never a tool result, reasoning, the query, the thread's
#       other messages or a whole window. Its text is read from grit_eval_<date>. Prints the
#       file's path and each case's id and record count, and the file only with --show.
#
#   scripts/eval reply-labels <review file>
#       The label lines filled in a replies file (a name in .local/eval/replies/, or a path)
#       read into .local/eval/reply-labels.json, by workflow, under the guide the file names,
#       each in place of an earlier label of the same turn; a note is never read. Prints
#       counts.
#
#   scripts/eval turns <yyyymmdd>
#       The capture's recorded turns (turns.jsonl) read structurally, with the review verdicts
#       standing (verdicts.json) joined by case, written to
#       .local/eval/reports/turns-<date>.md and printed: the pass rate first, then the turns
#       that did not reply, rounds, tools offered against called (the turn's topic tool and
#       unnamed calls apart), prompt and window tokens, the first main call's estimate against
#       the ledger, cost per turn by role, the prompt cache's hit rate (cached input tokens
#       of input: by role, and a turn's first main call against its later ones), speech outcomes with post and hold rates, verdicts
#       and the window parts a reply used (support >= 0.3, a lexical heuristic), each over
#       every turn, by root and by where said; then one line a turn by workflow, most costly
#       first, with its top 3 parts by support. Text-free; reads no database.
#
#   scripts/eval churn <yyyymmdd> <questions file> <before round> <after round> [--no-gold]
#       The capture's recorded turns' churn over the questions <questions file> holds
#       ({"<question id>": {"gold": {"facts": [["<alternative>", ...], ...], "never": [...]},
#       "asked": {"<round>": "<case id>", ...}}}, ids and gold alone; the questions' words stay
#       in a file of their own), paired by the two rounds: per turn, its hosted calls before its
#       first read through a document's pointer and before its first useful one (the reply's
#       support in the result at 0.3 or over), a turn that never reads counted apart; per pair
#       the before-turn's less the after-turn's, clustered by question, over every pair and
#       over the clean ones: neither turn's window holding a part of another paired thread
#       (confounded) nor of another asking of its own question (echoed). Unless --no-gold, each
#       reply is read from grit_eval_<date> and matched against its question's gold (every fact,
#       no never-string; counts kept, never words), giving the share right by side, calls to
#       correct (before less after, both right), and better (+1, -1 or 0 a pair: right after
#       fewer calls above right after more, above wrong having read, above wrong never having
#       read). Written to .local/eval/reports/churn-<date>-<before>-<after>.md and printed.
#       Text-free. Refused, naming the round, the question or the message, when no question was
#       asked in both rounds or no turn answers one side of a pair.
#
#   scripts/eval recall <yyyymmdd> [--until <instant>]
#       The recall replay: each turn grit_eval_<date> recorded before its dump (and started
#       before <instant>, to replay an earlier capture's turns over a later one's index) that
#       recorded its search and followed a document has its recorded query searched again by the
#       shipped assembler over the database as it stood at the dump, its documents too (not as of
#       the turn's root, where a turn draws them), every row read whatever the turn was cleared
#       for, no model asked; each document it followed is ranked by its current version, matched
#       by plugin and key, among all the search ranked. Written to
#       .local/eval/reports/recall-<date>.md and printed: the share ranked at or above 5, 10 and
#       the judged cut, ranked at all, and ranked by the turn's own search when it ran (the rest
#       reached its window otherwise, such as placed at its room), over all and by source (a
#       service, else a place's namespace), clustered by turn; documents gone (no current
#       version) and forgotten (the version followed no longer kept) apart; then one line a turn
#       by workflow, each document's rank then and now. A miss is not by itself a regression: a
#       card a later document absorbed is missed too. Text-free.
#
#   scripts/eval rebuild <yyyymmdd> --spend <usd> [--window <tokens>] [--tail <tokens>]
#                        [--judged <n>] [--pass <p>]
#       Every turn grit_eval_<date> recorded, its window rebuilt by the shipped retrieval
#       assembler over the database as it stood when the turn's assemble step started (rows
#       written later left out), its search query replayed from the one it recorded, so it
#       spends nothing; a turn that recorded its search packs, of the results it recorded, the
#       first --judged (30, the turn's own, and no more), each recorded as relevant at a
#       probability of --pass or over (0.5, the turn's own) or unjudged, no classifier asked;
#       and how each stands to the window it recorded, by ids: the same, a
#       section from elsewhere changed, its own entries changed, both, or gone (an entry it
#       showed was purged). Then each window-only case: a heard message live triage read as
#       asking (gap: asks) that no turn answered, its window rebuilt as of triage's answer, its
#       query written by the catalog's query model through OpenRouter and kept in
#       .local/eval/cache/, so an unchanged one is never paid for twice. --spend is a hard cap
#       in USD: refused before any call when the writes not kept are estimated over it, each
#       call past it skipped. The assembler has grit's default window and tail unless --window
#       or --tail names the deployment's. OpenRouter's key is OPENROUTER_API_KEY, from the
#       environment over GRIT_ENV_FILE (the main checkout's .env when unset), read only when a
#       write is to be asked. Prints counts and workflow ids, never text.
#
#   scripts/eval recipes <yyyymmdd> --variant <name>... --context <tokens> --spend <usd>
#                        [--window <tokens>] [--tail <tokens>]
#       Each named variant, a turn recipe (wide-heard, wide-addressed: twice the deployment's
#       window on that root's turns; offer-0.2, offer-0.3, offer-0.5: a service's tools
#       offered only when triage answers one of the corpora supplying it at least
#       that; offer-0.3-0.1: at 0.3 on a heard turn and 0.1 on one said to grit;
#       offer-heard-0.2: at 0.2 on a heard turn, every tool on one said to grit), decided as
#       the turn decides it, against shipped, paired on every turn grit_eval_<date>
#       recorded, written to .local/eval/reports/recipes-<date>.md and printed: tools offered
#       and their definitions' tokens saved, what those are worth (tokens saved once a
#       main-model call as the provider counts them (grit's estimate scaled by a per-model
#       ratio fitted from the ledger, or the raw estimate, labelled, where too few calls give
#       one), effective m$ with each call's share cached at the cached rate, the
#       range from all cached to none, the hit rate, and each model's rates as read from the
#       ledger), called-tool recall (of the tools a turn called,
#       those the variant still offers), window tokens per part, used-section recall (stated
#       undefined when no reply used a part) and the turns each changed, by id; then the
#       reference turns' pass rate under shipped and each variant. --context is the reply
#       model's context in tokens: a variant drawing a window over it is refused. A turn's
#       offering under a variant is decided over what it recorded: the services, sources and
#       tools of its shape, by the answers its weigh step recorded; a turn recorded before
#       shapes is offered as recorded under every variant, and the notes say how many shaped
#       turns each variant decides as recorded, naming those it does not. A message said to
#       grit whose recipe did not read it, where a variant gates a service its shape recorded,
#       is put live triage's set, as the database stood when the turn started, through Jev
#       once (a TUI or task turn's, with no case id, is not asked), with the knowledge
#       sources the deployment that recorded the capture declares, written beside it as
#       .local/eval/capture/<date>/knowledge.json ({"sources": [{"name", "line", "within",
#       "supplies"}]}, supplies a service's name, absent for a source no service's tools reach;
#       its lines are the deployment's words, no conversation's), since grit's database keeps
#       no declaration: refused when such a turn is to be asked and the file is missing, or
#       disagrees with the sources the turn's shape records. Each answer is kept in
#       .local/eval/cache/; --spend is a hard cap in USD: refused before any call when the
#       calls not kept are estimated over it, each call past it skipped. Windows are rebuilt
#       as rebuild draws them. The reference is .local/eval/reference.json ({"turns":
#       {<workflow>: [{"holds": <locator>} | {"offers": <service>} | {"withholds": <service>}]}},
#       ids only) and every answer .local/eval/reply-labels.json found in records shown. Jev's
#       key is JEV_API_KEY, read only when a call is to be asked. Text-free.
#
#   scripts/eval reference-build
#       grit.eval's hand-written cases (eval/src/Cases.scala) written into grit_eval_synthetic,
#       dropped and created afresh, through an engine opened on it: each case as written and
#       buried in filler, one entry per line, as the assembly eval writes them. Prints counts,
#       and the cases that label no [must] or [never] entry.
#
#   scripts/eval recipes synthetic --variant <name>... --context <tokens>
#                        [--window <tokens>] [--tail <tokens>]
#       The synthetic reference: each case of grit_eval_synthetic in each variant a turn said
#       to grit, expected to hold its [must] entries and none of its [never] entries (a case
#       labelling neither left out), judged under shipped and each named variant (as recipes
#       names them) by its window drawn at the variant's width by the shipped retrieval
#       assembler over the database as it stands, searched with the case's own query within
#       the case's scope; written to .local/eval/reports/recipes-synthetic.md and printed: each
#       variant's pass rate, clustered by case, and its failing turns by name. --context and the assembler's window
#       and tail are as for recipes. Spends nothing; build the database first.
#
#   scripts/eval lab stitch --room <name | file> [--spend <usd>] [--follows-at <p>]
#                           [--lexical <n>] [--recent <n>] [--repeats <n>]
#                           [--burst-prior <p> --burst-gap <seconds> | --burst none]
#       A synthetic room (eval/resources/rooms/<name>.json, or a file) heard into
#       grit_eval_lab, created afresh and dropped after, through an engine opened on it; then
#       each opening placed in the order said through the shipped stitch ask, under shipped
#       tuning but for the knobs named (--burst-prior: a follow of the strand the author
#       opened a conversation of within --burst-gap before passes at <p>; --burst none: no
#       burst prior, the baseline before the prior shipped), Jev asked through .local/eval/cache/, so an unchanged
#       room and tuning rerun at no cost. --repeats runs it that many times (default 1), each
#       a copy of the room in its own channel and Jev's repeat of the same index, so a repeat
#       asks Jev afresh once and is free after; and as many times again against the truth's
#       strands, each opening offered the strands the room's topics make rather than those
#       Jev's earlier placings made, so one misplacing does not change what later ones see. --spend is a hard cap in USD over every run
#       (default 0.01): the call that would cross it, and every opening after that would ask,
#       is skipped. Scored against the room's topics (offer recall, Jev given offered, the
#       confusion, bursts, wrong follows, strands split and mixed), each measure's mean and
#       range over the runs first, written to .local/eval/reports/lab-stitch-<room>.md, whose
#       rows of openings hold the room's own text, and printed up to the first run's rows.
#       Jev's key is JEV_API_KEY, as for run.
#
#   scripts/eval backfill --capture <yyyymmdd> --spend <usd> [--per-run <n>] [--from <day>]
#                         [--until <day>]
#       grit_eval_<date> copied afresh to grit_eval_shadow, every workflow left pending or
#       enqueued in the copy marked cancelled so its engine runs none, then the topics job
#       run on it for each day (UTC) its entries were written, from --from until --until
#       (yyyy-mm-dd, both included; default every one), oldest first, each twice
#       (TopicBackfill): the second run of each day is to write nothing and spend nothing,
#       and is printed `unchanged` when it does. At most --per-run topics a run (default 10).
#       --spend is the engine's daily cap in USD. Prints by shape only. The copy is left for
#       the next command (duplication), and dropped by the next backfill. OpenRouter's key and
#       the models' variables are read from the environment over GRIT_ENV_FILE (the main
#       checkout's .env when unset).
#
#   scripts/eval duplication <yyyymmdd> [--window <tokens>] [--tail <tokens>]
#       Every turn capture <date> recorded, its window drawn again over grit_eval_shadow (the
#       copy backfill left) as rebuild draws it, but for its documents, read as the copy holds
#       them now, so the topics backfill wrote are found; its search run again under the query
#       it recorded, all it finds packed, nothing spent. Prints how many windows held a topic,
#       and how many held a topic with its own leaf: the document of a strand it was written
#       from, or a Standing document of one of that strand's conversations; with their
#       workflow ids. Text-free.
#
#   scripts/eval summaries <yyyymmdd> --models <id>,<id> --spend <usd> [--first <n>]
#                          [--dry-run]
#       The first --first turns (30) grit_eval_<date> recorded that kept a summary, each one's
#       summary request rebuilt by the turn's own builder and asked of each OpenRouter model
#       named, at the catalog's summary settings, each answer kept in .local/eval/cache/ so it
#       is paid for once, under the --spend cap in USD over all of them (refused when the
#       estimate is over it). Written side by side, the live summary first, each with its
#       tokens and cost, to .local/eval/review/summaries-<date>.md, which holds the summaries'
#       text; prints counts, the estimate and the spend. --dry-run prints the cases and the
#       estimate and asks nothing. OpenRouter's key as for rebuild.
#
# Its data is the main checkout's .local/eval/, whichever checkout runs it. It never writes
# to the database it dumps.
set -euo pipefail

usage() { sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//' >&2; exit 2; }
[ $# -ge 1 ] || usage

here=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
main=$(cd "$(git -C "$here" rev-parse --path-format=absolute --git-common-dir)/.." && pwd)
cd "$here"

compose() { docker compose --project-directory "$main" exec -T postgres "$@"; }
exists() { [ "$(compose psql -U grit -d postgres -Atc "SELECT 1 FROM pg_database WHERE datname = '$1'")" = 1 ]; }

harness() {
  # `show` prints a PathRef, "ref:v0:<hash>:<path>"; the path is everything after the third colon.
  path_of() { ./mill --ticker false show "$1" | tail -1 | tr -d '"' | cut -d: -f4-; }
  local launcher
  launcher=$(path_of grit.eval.harness.launcher)
  JAVA_HOME=$(path_of grit.eval.harness.javaHome) "$launcher" "$@"
}

capture() {
  local from= date
  date=$(date -u +%Y%m%d)
  while [ $# -gt 0 ]; do
    case $1 in
      --from) from=$2; shift 2 ;;
      --date) date=$2; shift 2 ;;
      *) usage ;;
    esac
  done
  [ -n "$from" ] || usage
  [[ $date =~ ^[0-9]{8}$ ]] || { echo "eval: --date is yyyymmdd" >&2; exit 2; }
  local dir="$main/.local/eval/capture/$date" restored="grit_eval_$date"
  mkdir -p "$dir"
  if [ ! -f "$dir/dump.txt" ]; then
    if [ -e "$dir/source.dump" ] || exists "$restored"; then
      echo "eval: an earlier capture into $dir did not finish: remove $dir/source.dump and drop $restored" >&2
      exit 1
    fi
    compose pg_dump -U grit -Fc "$from" >"$dir/source.dump"
    # When the dump finished: every row in it was written before then.
    local dumped
    dumped=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    compose createdb -U grit "$restored"
    # pg_restore's errors can quote the rows it was restoring, so they go where only a person
    # reads them.
    local log="$main/.local/eval/review/restore-$date.log"
    mkdir -p "$(dirname "$log")"
    compose pg_restore -U grit -d "$restored" --no-owner --exit-on-error \
      <"$dir/source.dump" 2>"$log" ||
      { echo "eval: pg_restore failed; its errors are in $log" >&2; exit 1; }
    printf 'source=%s\nsha256=%s\nat=%s\n' "$from" \
      "$(sha256sum "$dir/source.dump" | cut -d' ' -f1)" "$dumped" >"$dir/dump.txt"
    echo "dumped $from and restored it to $restored"
  else
    exists "$restored" || { echo "eval: $dir has a dump but $restored is gone" >&2; exit 1; }
    echo "reusing $dir/source.dump, restored in $restored"
  fi
  local source sha at
  source=$(sed -n 's/^source=//p' "$dir/dump.txt")
  [ "$source" = "$from" ] || { echo "eval: $dir was dumped from $source, not $from" >&2; exit 1; }
  sha=$(sed -n 's/^sha256=//p' "$dir/dump.txt")
  at=$(sed -n 's/^at=//p' "$dir/dump.txt")
  harness capture --url "jdbc:postgresql://localhost:5432/$restored" --source "$from" \
    --restored "$restored" --sha256 "$sha" --at "$at" --out "$dir"
}

run() {
  local capture=
  local rest=()
  while [ $# -gt 0 ]; do
    case $1 in
      --capture) capture=$2; shift 2 ;;
      *) rest+=("$1"); shift ;;
    esac
  done
  [[ $capture =~ ^[0-9]{8}$ ]] || { echo "eval: --capture is yyyymmdd" >&2; exit 2; }
  local dir="$main/.local/eval/capture/$capture" restored="grit_eval_$capture"
  [ -f "$dir/capture.json" ] || { echo "eval: no capture in $dir" >&2; exit 1; }
  exists "$restored" || { echo "eval: $restored is gone; capture again" >&2; exit 1; }
  export GRIT_ENV_FILE="${GRIT_ENV_FILE:-$main/.env}"
  harness run --capture "$dir" \
    --url "jdbc:postgresql://localhost:5432/$restored" \
    --cache "$main/.local/eval/cache" --runs "$main/.local/eval/runs" \
    --labels "$main/.local/eval/labels.json" "${rest[@]}"
}

determinism() {
  local capture= log=
  while [ $# -gt 0 ]; do
    case $1 in
      --capture) capture=$2; shift 2 ;;
      --log) log=$2; shift 2 ;;
      *) usage ;;
    esac
  done
  [[ $capture =~ ^[0-9]{8}$ ]] && [ -n "$log" ] || usage
  harness determinism --capture "$main/.local/eval/capture/$capture" \
    --log "$main/.local/eval/runs/$log"
}

inputs() {
  local capture=${1:-} more= variant=live
  [[ $capture =~ ^[0-9]{8}$ ]] || usage
  shift
  while [ $# -gt 0 ]; do
    case $1 in
      --more) more=--more; shift ;;
      --variant) variant=${2:-}; shift 2 ;;
      *) usage ;;
    esac
  done
  [ -n "$variant" ] || usage
  local dir="$main/.local/eval/capture/$capture" restored="grit_eval_$capture"
  local name="inputs-$capture"
  [ "$variant" = live ] || name="$name-$variant"
  [ -f "$dir/capture.json" ] || { echo "eval: no capture in $dir" >&2; exit 1; }
  exists "$restored" || { echo "eval: $restored is gone; capture again" >&2; exit 1; }
  harness inputs --capture "$dir" --url "jdbc:postgresql://localhost:5432/$restored" \
    --out "$main/.local/eval/review/$name.jsonl" --variant "$variant" $more
}

score() {
  local name=${1:-}
  [ -n "$name" ] || usage
  shift
  harness score --eval "$main/.local/eval" --run "$name" "$@"
}

compare() {
  local a=${1:-} b=${2:-}
  [ -n "$a" ] && [ -n "$b" ] || usage
  shift 2
  harness compare --eval "$main/.local/eval" --a "$a" --b "$b" "$@"
}

order() {
  local a=${1:-} b=
  [ -n "$a" ] || usage
  shift
  if [ $# -gt 0 ] && [[ $1 != --* ]]; then b=$1; shift; fi
  harness order --eval "$main/.local/eval" --a "$a" ${b:+--b "$b"} "$@"
}

context() {
  local id=${1:-} from= full= capture=
  [ -n "$id" ] && [[ $id != --* ]] || usage
  shift
  while [ $# -gt 0 ]; do
    case $1 in
      --from) from=${2:-}; shift 2 ;;
      --full) full=--full; shift ;;
      --capture) capture=${2:-}; shift 2 ;;
      *) usage ;;
    esac
  done
  [ -n "$from" ] || usage
  exists "$from" || { echo "eval: no database $from" >&2; exit 1; }
  local out="$main/.local/eval/review/context-$id.md" url="jdbc:postgresql://localhost:5432/$from"
  if [[ $id =~ ^[0-9a-f-]{36}:[0-9]+$ ]]; then
    harness context --url "$url" --from "$from" --workflow "$id" --out "$out" $full
  else
    local declared=()
    if [ -n "$capture" ]; then
      [ -d "$main/.local/eval/capture/$capture" ] || { echo "eval: no capture $capture" >&2; exit 1; }
      declared=(--declared "$main/.local/eval/capture/$capture")
    fi
    harness context --url "$url" --from "$from" --entry "$id" --out "$out" "${declared[@]}"
  fi
}

pull() {
  local from= capture=
  local rest=()
  while [ $# -gt 0 ]; do
    case $1 in
      --from) from=$2; shift 2 ;;
      --capture) capture=$2; shift 2 ;;
      *) rest+=("$1"); shift ;;
    esac
  done
  [ -n "$from" ] || usage
  [[ $capture =~ ^[0-9]{8}$ ]] || { echo "eval: --capture is yyyymmdd" >&2; exit 2; }
  local dir="$main/.local/eval/capture/$capture"
  [ -f "$dir/capture.json" ] || { echo "eval: no capture in $dir" >&2; exit 1; }
  exists "$from" || { echo "eval: no database $from" >&2; exit 1; }
  harness pull --capture "$dir" --url "jdbc:postgresql://localhost:5432/$from" \
    --runs "$main/.local/eval/runs" "${rest[@]}"
}

replies() {
  local capture=${1:-}
  [[ $capture =~ ^[0-9]{8}$ ]] || usage
  shift
  local cases=() rest=()
  while [ $# -gt 0 ]; do
    case $1 in
      --case)
        shift
        while [ $# -gt 0 ] && [[ $1 != --* ]]; do cases+=("$1"); shift; done ;;
      --pick | --by) [ $# -ge 2 ] || usage; rest+=("$1" "$2"); shift 2 ;;
      --records | --show) rest+=("$1"); shift ;;
      *) usage ;;
    esac
  done
  local dir="$main/.local/eval/capture/$capture" restored="grit_eval_$capture"
  [ -f "$dir/turns.jsonl" ] || { echo "eval: no turns in $dir; capture again" >&2; exit 1; }
  exists "$restored" || { echo "eval: $restored is gone; capture again" >&2; exit 1; }
  local named=()
  [ ${#cases[@]} -eq 0 ] || named=(--cases "$(IFS=,; echo "${cases[*]}")")
  harness replies --capture "$dir" --url "jdbc:postgresql://localhost:5432/$restored" \
    --out "$main/.local/eval/replies" --labels "$main/.local/eval/reply-labels.json" \
    "${named[@]}" "${rest[@]}"
}

turns() {
  local capture=${1:-}
  [[ $capture =~ ^[0-9]{8}$ ]] && [ $# -eq 1 ] || usage
  [ -f "$main/.local/eval/capture/$capture/turns.jsonl" ] ||
    { echo "eval: no turns in $main/.local/eval/capture/$capture; capture again" >&2; exit 1; }
  harness turns --eval "$main/.local/eval" --capture "$capture"
}

churn() {
  local capture=${1:-} questions=${2:-} before=${3:-} after=${4:-}
  [[ $capture =~ ^[0-9]{8}$ ]] && [ -n "$after" ] || usage
  shift 4
  local gold=1
  case $# in
    0) ;;
    1) [ "$1" = --no-gold ] || usage; gold= ;;
    *) usage ;;
  esac
  [ -f "$main/.local/eval/capture/$capture/turns.jsonl" ] ||
    { echo "eval: no turns in $main/.local/eval/capture/$capture; capture again" >&2; exit 1; }
  # The script runs from its checkout: a relative path is the caller's.
  case $questions in /*) ;; *) questions="$OLDPWD/$questions" ;; esac
  [ -f "$questions" ] || { echo "eval: no questions file $questions" >&2; exit 1; }
  local url=()
  if [ -n "$gold" ]; then
    local restored="grit_eval_$capture"
    exists "$restored" || { echo "eval: $restored is gone; capture again, or --no-gold" >&2; exit 1; }
    export GRIT_ENV_FILE="${GRIT_ENV_FILE:-$main/.env}"
    url=(--url "jdbc:postgresql://localhost:5432/$restored")
  fi
  harness churn --eval "$main/.local/eval" --capture "$capture" --questions "$questions" \
    --before "$before" --after "$after" "${url[@]}"
}

recall() {
  local capture=${1:-}
  [[ $capture =~ ^[0-9]{8}$ ]] || usage
  shift
  local until=()
  case $# in
    0) ;;
    2) [ "$1" = --until ] || usage; until=(--until "$2") ;;
    *) usage ;;
  esac
  local dir="$main/.local/eval/capture/$capture" restored="grit_eval_$capture"
  [ -f "$dir/capture.json" ] || { echo "eval: no capture in $dir" >&2; exit 1; }
  exists "$restored" || { echo "eval: $restored is gone; capture again" >&2; exit 1; }
  export GRIT_ENV_FILE="${GRIT_ENV_FILE:-$main/.env}"
  harness recall --eval "$main/.local/eval" --capture "$capture" \
    --url "jdbc:postgresql://localhost:5432/$restored" "${until[@]}"
}

rebuild() {
  local capture=${1:-}
  [[ $capture =~ ^[0-9]{8}$ ]] || usage
  shift
  local dir="$main/.local/eval/capture/$capture" restored="grit_eval_$capture"
  [ -f "$dir/capture.json" ] || { echo "eval: no capture in $dir" >&2; exit 1; }
  exists "$restored" || { echo "eval: $restored is gone; capture again" >&2; exit 1; }
  export GRIT_ENV_FILE="${GRIT_ENV_FILE:-$main/.env}"
  harness rebuild --capture "$dir" --url "jdbc:postgresql://localhost:5432/$restored" \
    --cache "$main/.local/eval/cache" "$@"
}

recipes() {
  local capture=${1:-}
  if [ "$capture" = synthetic ]; then shift; synthetic "$@"; return; fi
  [[ $capture =~ ^[0-9]{8}$ ]] || usage
  shift
  local variants=() rest=()
  while [ $# -gt 0 ]; do
    case $1 in
      --variant)
        shift
        while [ $# -gt 0 ] && [[ $1 != --* ]]; do variants+=("$1"); shift; done ;;
      --context | --spend | --window | --tail) [ $# -ge 2 ] || usage; rest+=("$1" "$2"); shift 2 ;;
      *) usage ;;
    esac
  done
  [ ${#variants[@]} -gt 0 ] || usage
  local dir="$main/.local/eval/capture/$capture" restored="grit_eval_$capture"
  [ -f "$dir/turns.jsonl" ] || { echo "eval: no turns in $dir; capture again" >&2; exit 1; }
  exists "$restored" || { echo "eval: $restored is gone; capture again" >&2; exit 1; }
  export GRIT_ENV_FILE="${GRIT_ENV_FILE:-$main/.env}"
  harness recipes --eval "$main/.local/eval" --capture "$capture" \
    --url "jdbc:postgresql://localhost:5432/$restored" \
    --variants "$(IFS=,; echo "${variants[*]}")" \
    --cache "$main/.local/eval/cache" \
    --reference "$main/.local/eval/reference.json" \
    --labels "$main/.local/eval/reply-labels.json" "${rest[@]}"
}

reference_build() {
  [ $# -eq 0 ] || usage
  local db=grit_eval_synthetic
  compose dropdb -U grit --if-exists "$db"
  compose createdb -U grit "$db"
  harness reference-build --url "jdbc:postgresql://localhost:5432/$db"
}

synthetic() {
  local variants=() rest=()
  while [ $# -gt 0 ]; do
    case $1 in
      --variant)
        shift
        while [ $# -gt 0 ] && [[ $1 != --* ]]; do variants+=("$1"); shift; done ;;
      --context | --window | --tail) [ $# -ge 2 ] || usage; rest+=("$1" "$2"); shift 2 ;;
      *) usage ;;
    esac
  done
  [ ${#variants[@]} -gt 0 ] || usage
  exists grit_eval_synthetic ||
    { echo "eval: grit_eval_synthetic is gone; build it with scripts/eval reference-build" >&2; exit 1; }
  harness synthetic --eval "$main/.local/eval" \
    --url "jdbc:postgresql://localhost:5432/grit_eval_synthetic" \
    --variants "$(IFS=,; echo "${variants[*]}")" "${rest[@]}"
}

lab() {
  [ "${1:-}" = stitch ] || usage
  shift
  local room= spend=0.01 rest=()
  while [ $# -gt 0 ]; do
    case $1 in
      --room) [ $# -ge 2 ] || usage; room=$2; shift 2 ;;
      --spend) [ $# -ge 2 ] || usage; spend=$2; shift 2 ;;
      --follows-at | --lexical | --recent | --repeats | --burst | --burst-prior | --burst-gap) [ $# -ge 2 ] || usage; rest+=("$1" "$2"); shift 2 ;;
      *) usage ;;
    esac
  done
  [ -n "$room" ] || usage
  [[ $room == */* || $room == *.json ]] || room="$here/eval/resources/rooms/$room.json"
  [ -f "$room" ] || { echo "eval: no room at $room" >&2; exit 1; }
  local db=grit_eval_lab
  compose dropdb -U grit --if-exists "$db"
  compose createdb -U grit "$db"
  trap 'compose dropdb -U grit --if-exists grit_eval_lab' EXIT
  export GRIT_ENV_FILE="${GRIT_ENV_FILE:-$main/.env}"
  harness lab-stitch --room "$(realpath "$room")" --url "jdbc:postgresql://localhost:5432/$db" \
    --cache "$main/.local/eval/cache" --spend "$spend" --out "$main/.local/eval/reports" \
    "${rest[@]}"
}

backfill() {
  local date= spend= perRun=10 from=0001-01-01 until=9999-12-31
  while [ $# -gt 0 ]; do
    case $1 in
      --capture) [ $# -ge 2 ] || usage; date=$2; shift 2 ;;
      --spend) [ $# -ge 2 ] || usage; spend=$2; shift 2 ;;
      --per-run) [ $# -ge 2 ] || usage; perRun=$2; shift 2 ;;
      --from) [ $# -ge 2 ] || usage; from=$2; shift 2 ;;
      --until) [ $# -ge 2 ] || usage; until=$2; shift 2 ;;
      *) usage ;;
    esac
  done
  [ -n "$date" ] && [ -n "$spend" ] || usage
  [[ $date =~ ^[0-9]{8}$ ]] || { echo "eval: --capture is yyyymmdd" >&2; exit 2; }
  [[ $from =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ && $until =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] ||
    { echo "eval: --from and --until are yyyy-mm-dd" >&2; exit 2; }
  local source="grit_eval_$date" db=grit_eval_shadow
  exists "$source" || { echo "eval: no capture $source" >&2; exit 1; }
  compose dropdb -U grit --if-exists "$db"
  compose createdb -U grit -T "$source" "$db"
  local cancelled
  cancelled=$(compose psql -U grit -d "$db" -Atc \
    "WITH c AS (UPDATE dbos.workflow_status SET status = 'CANCELLED' WHERE status IN ('PENDING', 'ENQUEUED') RETURNING 1) SELECT count(*) FROM c")
  echo "eval: $cancelled workflows left pending or enqueued in the copy, cancelled"
  local days
  days=$(compose psql -U grit -d "$db" -Atc \
    "SELECT DISTINCT (created_at AT TIME ZONE 'UTC')::date FROM grit.entries WHERE (created_at AT TIME ZONE 'UTC')::date BETWEEN '$from' AND '$until' ORDER BY 1")
  [ -n "$days" ] || { echo "eval: no entries between $from and $until" >&2; exit 1; }
  # shellcheck disable=SC2086 # one argument a day
  GRIT_ENV_FILE="${GRIT_ENV_FILE:-$main/.env}" \
    GRIT_DATABASE_URL="jdbc:postgresql://localhost:5432/$db" \
    ./mill --ticker false grit.app.it.runMain grit.app.main.TopicBackfill "$spend" "$perRun" $days
}

duplication() {
  local capture=${1:-}
  [[ $capture =~ ^[0-9]{8}$ ]] || usage
  shift
  local dir="$main/.local/eval/capture/$capture" db=grit_eval_shadow
  [ -f "$dir/capture.json" ] || { echo "eval: no capture in $dir" >&2; exit 1; }
  exists "$db" || { echo "eval: no $db; run backfill first" >&2; exit 1; }
  export GRIT_ENV_FILE="${GRIT_ENV_FILE:-$main/.env}"
  harness duplication --capture "$dir" --url "jdbc:postgresql://localhost:5432/$db" "$@"
}

summaries() {
  local capture=${1:-}
  [[ $capture =~ ^[0-9]{8}$ ]] || usage
  shift
  local args=()
  while [ $# -gt 0 ]; do
    case $1 in
      --dry-run) args+=(--dry-run true); shift ;;
      *) args+=("$1"); shift ;;
    esac
  done
  local dir="$main/.local/eval/capture/$capture" restored="grit_eval_$capture"
  [ -f "$dir/capture.json" ] || { echo "eval: no capture in $dir" >&2; exit 1; }
  exists "$restored" || { echo "eval: $restored is gone; capture again" >&2; exit 1; }
  mkdir -p "$main/.local/eval/review"
  export GRIT_ENV_FILE="${GRIT_ENV_FILE:-$main/.env}"
  harness summaries --capture "$dir" --url "jdbc:postgresql://localhost:5432/$restored" \
    --cache "$main/.local/eval/cache" --out "$main/.local/eval/review/summaries-$capture.md" \
    "${args[@]}"
}

reply_labels() {
  local file=${1:-}
  [ -n "$file" ] && [ $# -eq 1 ] || usage
  [[ $file == */* ]] || file="$main/.local/eval/replies/$file"
  harness reply-labels --file "$file" --labels "$main/.local/eval/reply-labels.json"
}

case $1 in
  capture) shift; capture "$@" ;;
  backfill) shift; backfill "$@" ;;
  duplication) shift; duplication "$@" ;;
  summaries) shift; summaries "$@" ;;
  replies) shift; replies "$@" ;;
  reply-labels) shift; reply_labels "$@" ;;
  turns) shift; turns "$@" ;;
  churn) shift; churn "$@" ;;
  recall) shift; recall "$@" ;;
  rebuild) shift; rebuild "$@" ;;
  recipes) shift; recipes "$@" ;;
  reference-build) shift; reference_build "$@" ;;
  lab) shift; lab "$@" ;;
  pull) shift; pull "$@" ;;
  order) shift; order "$@" ;;
  score) shift; score "$@" ;;
  compare) shift; compare "$@" ;;
  inputs) shift; inputs "$@" ;;
  context) shift; context "$@" ;;
  determinism) shift; determinism "$@" ;;
  run) shift; run "$@" ;;
  *) usage ;;
esac
