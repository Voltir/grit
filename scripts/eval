#!/usr/bin/env bash
# The eval harness (eval/harness/README.md), run with mill out of the loop: mill builds the
# launcher and exits, then java runs the harness directly.
#
#   scripts/eval capture --from <database> [--date <yyyymmdd>]
#       A corpus of <database>'s heard messages, in .local/eval/corpus/<date>/ (date: today,
#       UTC). The first run dumps <database> (pg_dump -Fc, an MVCC read beside a running
#       engine: source.dump, and its sha256 and time in dump.txt, written once it is restored) and restores it to
#       grit_eval_<date>, which must not exist yet; a later run reuses both. Each run then
#       writes corpus.json and cases.jsonl, text-free, and prints counts. Rerun over the same
#       restored database by the same build, it writes the same bytes. A failed restore's
#       errors, which can quote rows, go to .local/eval/review/restore-<date>.log.
#
#   scripts/eval run --corpus <yyyymmdd> --variant <name> --spend <usd> [--repeats n]
#                    [--first n] [--no-cache] [--rule <file>]
#       Every case of the corpus rebuilt through the shipped builders from grit_eval_<date>,
#       how its inputs changed from capture printed (ids and counts), then asked of Jev as
#       the variant says (live, durable-lasting, jev-latest, nearby-open, exchanges-open,
#       nearby-author-open, sections-named, nearby-open+named, exchanges-open+named,
#       nearby-author-open+named): each request --repeats times
#       (default 3: Jev's answers vary from call to call), over the first n cases by ts with
#       --first, answered from .local/eval/cache/ unless --no-cache. --spend is a hard cap in
#       USD: the run refuses before any call when its estimate is over it, and skips every
#       call past it. Writes
#       .local/eval/runs/<stamp>-<variant>.jsonl and prints counts and the spend. Jev's key
#       is JEV_API_KEY, from the environment over GRIT_ENV_FILE (the main checkout's .env
#       when unset), read by the harness as grit does.
#
#   scripts/eval determinism --corpus <yyyymmdd> --log <runs file>
#       How far apart a run's repeats answered, and how far its answers are from what triage
#       and stitching kept live: the largest gap, and the questions and cases over 1e-9, by
#       id. <runs file> is a name in .local/eval/runs/.
#
#   scripts/eval inputs <yyyymmdd> [--more] [--variant <name>]
#       Every case's questions rebuilt through the shipped builders from grit_eval_<date>,
#       triage's by the variant's recipe (default live, the shipped), and written, text and
#       all, to .local/eval/review/inputs-<date>.jsonl (inputs-<date>-<variant>.jsonl for
#       another variant), a line a case:
#       triage's and stitching's request (the state as the classifier receives it, and the
#       questions' words) and digest, and stitching's state shown live beside it. With
#       --more, triage's line also holds what its thread left out, and where. Prints counts,
#       and how each digest compares to cases.jsonl's: never the file's text.
#
#   scripts/eval score <runs file> [--labels <file>]
#       The run scored, written to .local/eval/reports/<run>.md and printed: text-free, ids
#       and numbers. Labels come from .local/eval/labels.json (or <file>); with none it says
#       "unlabelled: 0 of N cases labelled" and gives what needs no label: spend and latency,
#       the repeats' spread, and agreement with what triage and stitching kept live. Once
#       labels exist: Brier scores, reliability, threshold sweeps and the expected-cost curve
#       over the cost-of-error ratio, all and by the label context (ok, short). Every mean
#       has its 95% interval clustered by exchange, and by author beside it.
#
#   scripts/eval compare <runs file A> <runs file B> [--labels <file>] [--decide <rule>]
#                        [--replica <runs file> --spread <runs file>]
#       Run B against run A, paired on the cases both answered: B - A per question, the
#       cases each question's decision fixed, broke or moved, by id, and once labels exist
#       the paired difference in Brier score with its MDE; and the cases whose triage
#       inputs differ between A and B, by context and focus, B - A over them alone, each
#       run's input tokens and cost per call, and the MDE A's repeat noise implies on them.
#       Written to .local/eval/reports/<A>-vs-<B>.md and printed. With --decide, the
#       adoption rule in <rule> (JSON: {"question": "durable", "metric": "brier", "better":
#       "lower", "least": 0.01}; "question": "mean" for the mean of kind, waiting, durable
#       and helps; optionally "context": "short", "guard": {"context": "ok", "worse_by":
#       0.02} over those four, and "not_worse": {"question": "helps", "worse_by": 0} in the
#       rule's context, each judged on the mean difference) judges B over A, and the exit
#       code says what it decided: 0 adopt B, 3 refused (B was not run with --rule <rule>,
#       the difference is under its MDE or the rule's least, or a guard is broken), 4 keep A. With --replica, a pulled replica shadow's log (the shipped
#       wording, of the live model), A being a pulled live log: each case whose replica answer
#       stands from live's by more than 10 × Jev's repeat spread on some question (measured as
#       each question's pooled standard deviation in the --spread run, which has repeats) has
#       moved on since live triage asked, and is listed and left out of the comparison.
#
#   scripts/eval compare <runs file A> <runs file B> --gate <set> --helps-at <p> [--labels <file>]
#       B a question set's shadow log from pull, asking <set> (v2), against A, live triage's
#       pulled log: the set's derived draft against live's helps gate (helps >= <p>, the
#       deployment's configured helpsAt, and kind not chatter: triage's tags alone, not live's
#       speech decision), a 2x2 by focus and over all; each of the set's probabilities' mean
#       and standard deviation; and its durable against live's durable, each at 0.5. Counts
#       only, written to .local/eval/reports/<A>-vs-<B>.md and printed; the ids of the cases
#       each decided alone go to .local/eval/order/<yyyymmdd>-draft-<set>-live-only.txt and
#       -set-only.txt, for labelling. Takes no --decide, --replica or --spread.
#
#   scripts/eval order <runs file A> [<runs file B>] [--tag <question>] [--by spread|difference]
#       Case ids in labelling order, one a line, in
#       .local/eval/order/<yyyymmdd>-<question>-<by>.txt, for eval-label's --order: those not
#       yet labelled on <question> (kind, waiting, durable, helps or place; default durable)
#       first, each by the difference between runs A and B on it (the default with B), or by
#       run A's repeat spread on it, Jev's own uncertainty (the default without), largest
#       first. Prints counts.
#
#   scripts/eval pull --from <database> --corpus <yyyymmdd> --shadows <name,...> [--since <instant>]
#       What <database> kept of the heard messages tagged since <instant> (default: ever) that
#       the corpus holds, as run logs in .local/eval/runs/ for score, compare and order: live
#       triage's tags as live-<today>.jsonl (variant `kept`: only the likeliest kind's
#       probability is kept live), and each named shadow's answers as
#       shadow-<name>-<today>.jsonl: a wording's by position, as live's are; a question set's
#       under its questions' names, the names in its header. A shadow whose rows are of both
#       (its name declared for a wording and then a set) is refused: no log, its counts
#       printed; declare a changed question under a new name. Only reads <database>. Prints counts: each log's rows, and
#       for each shadow the messages tagged since that it has no row for, its shadow ended
#       keeping nothing or not yet run; and the ids of the messages no corpus holds yet, for
#       the next capture.
#
# Its data is the main checkout's .local/eval/, whichever checkout runs it. It never writes
# to the database it dumps.
set -euo pipefail

usage() { sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//' >&2; exit 2; }
[ $# -ge 1 ] || usage

here=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
main=$(cd "$(git -C "$here" rev-parse --path-format=absolute --git-common-dir)/.." && pwd)
cd "$here"

compose() { docker compose --project-directory "$main" exec -T postgres "$@"; }
exists() { [ "$(compose psql -U grit -d postgres -Atc "SELECT 1 FROM pg_database WHERE datname = '$1'")" = 1 ]; }

harness() {
  # `show` prints a PathRef, "ref:v0:<hash>:<path>"; the path is everything after the third colon.
  path_of() { ./mill --ticker false show "$1" | tail -1 | tr -d '"' | cut -d: -f4-; }
  local launcher
  launcher=$(path_of grit.eval.harness.launcher)
  JAVA_HOME=$(path_of grit.eval.harness.javaHome) "$launcher" "$@"
}

capture() {
  local from= date
  date=$(date -u +%Y%m%d)
  while [ $# -gt 0 ]; do
    case $1 in
      --from) from=$2; shift 2 ;;
      --date) date=$2; shift 2 ;;
      *) usage ;;
    esac
  done
  [ -n "$from" ] || usage
  [[ $date =~ ^[0-9]{8}$ ]] || { echo "eval: --date is yyyymmdd" >&2; exit 2; }
  local dir="$main/.local/eval/corpus/$date" restored="grit_eval_$date"
  mkdir -p "$dir"
  if [ ! -f "$dir/dump.txt" ]; then
    if [ -e "$dir/source.dump" ] || exists "$restored"; then
      echo "eval: an earlier capture into $dir did not finish: remove $dir/source.dump and drop $restored" >&2
      exit 1
    fi
    compose pg_dump -U grit -Fc "$from" >"$dir/source.dump"
    # When the dump finished: every row in it was written before then.
    local dumped
    dumped=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    compose createdb -U grit "$restored"
    # pg_restore's errors can quote the rows it was restoring, so they go where only a person
    # reads them.
    local log="$main/.local/eval/review/restore-$date.log"
    mkdir -p "$(dirname "$log")"
    compose pg_restore -U grit -d "$restored" --no-owner --exit-on-error \
      <"$dir/source.dump" 2>"$log" ||
      { echo "eval: pg_restore failed; its errors are in $log" >&2; exit 1; }
    printf 'source=%s\nsha256=%s\nat=%s\n' "$from" \
      "$(sha256sum "$dir/source.dump" | cut -d' ' -f1)" "$dumped" >"$dir/dump.txt"
    echo "dumped $from and restored it to $restored"
  else
    exists "$restored" || { echo "eval: $dir has a dump but $restored is gone" >&2; exit 1; }
    echo "reusing $dir/source.dump, restored in $restored"
  fi
  local source sha at
  source=$(sed -n 's/^source=//p' "$dir/dump.txt")
  [ "$source" = "$from" ] || { echo "eval: $dir was dumped from $source, not $from" >&2; exit 1; }
  sha=$(sed -n 's/^sha256=//p' "$dir/dump.txt")
  at=$(sed -n 's/^at=//p' "$dir/dump.txt")
  harness capture --url "jdbc:postgresql://localhost:5432/$restored" --source "$from" \
    --restored "$restored" --sha256 "$sha" --at "$at" --out "$dir"
}

run() {
  local corpus=
  local rest=()
  while [ $# -gt 0 ]; do
    case $1 in
      --corpus) corpus=$2; shift 2 ;;
      *) rest+=("$1"); shift ;;
    esac
  done
  [[ $corpus =~ ^[0-9]{8}$ ]] || { echo "eval: --corpus is yyyymmdd" >&2; exit 2; }
  local dir="$main/.local/eval/corpus/$corpus" restored="grit_eval_$corpus"
  [ -f "$dir/corpus.json" ] || { echo "eval: no corpus in $dir" >&2; exit 1; }
  exists "$restored" || { echo "eval: $restored is gone; capture the corpus again" >&2; exit 1; }
  export GRIT_ENV_FILE="${GRIT_ENV_FILE:-$main/.env}"
  harness run --corpus "$dir" \
    --url "jdbc:postgresql://localhost:5432/$restored" \
    --cache "$main/.local/eval/cache" --runs "$main/.local/eval/runs" \
    --labels "$main/.local/eval/labels.json" "${rest[@]}"
}

determinism() {
  local corpus= log=
  while [ $# -gt 0 ]; do
    case $1 in
      --corpus) corpus=$2; shift 2 ;;
      --log) log=$2; shift 2 ;;
      *) usage ;;
    esac
  done
  [[ $corpus =~ ^[0-9]{8}$ ]] && [ -n "$log" ] || usage
  harness determinism --corpus "$main/.local/eval/corpus/$corpus" \
    --log "$main/.local/eval/runs/$log"
}

inputs() {
  local corpus=${1:-} more= variant=live
  [[ $corpus =~ ^[0-9]{8}$ ]] || usage
  shift
  while [ $# -gt 0 ]; do
    case $1 in
      --more) more=--more; shift ;;
      --variant) variant=${2:-}; shift 2 ;;
      *) usage ;;
    esac
  done
  [ -n "$variant" ] || usage
  local dir="$main/.local/eval/corpus/$corpus" restored="grit_eval_$corpus"
  local name="inputs-$corpus"
  [ "$variant" = live ] || name="$name-$variant"
  [ -f "$dir/corpus.json" ] || { echo "eval: no corpus in $dir" >&2; exit 1; }
  exists "$restored" || { echo "eval: $restored is gone; capture the corpus again" >&2; exit 1; }
  harness inputs --corpus "$dir" --url "jdbc:postgresql://localhost:5432/$restored" \
    --out "$main/.local/eval/review/$name.jsonl" --variant "$variant" $more
}

score() {
  local name=${1:-}
  [ -n "$name" ] || usage
  shift
  harness score --eval "$main/.local/eval" --run "$name" "$@"
}

compare() {
  local a=${1:-} b=${2:-}
  [ -n "$a" ] && [ -n "$b" ] || usage
  shift 2
  harness compare --eval "$main/.local/eval" --a "$a" --b "$b" "$@"
}

order() {
  local a=${1:-} b=
  [ -n "$a" ] || usage
  shift
  if [ $# -gt 0 ] && [[ $1 != --* ]]; then b=$1; shift; fi
  harness order --eval "$main/.local/eval" --a "$a" ${b:+--b "$b"} "$@"
}

pull() {
  local from= corpus=
  local rest=()
  while [ $# -gt 0 ]; do
    case $1 in
      --from) from=$2; shift 2 ;;
      --corpus) corpus=$2; shift 2 ;;
      *) rest+=("$1"); shift ;;
    esac
  done
  [ -n "$from" ] || usage
  [[ $corpus =~ ^[0-9]{8}$ ]] || { echo "eval: --corpus is yyyymmdd" >&2; exit 2; }
  local dir="$main/.local/eval/corpus/$corpus"
  [ -f "$dir/corpus.json" ] || { echo "eval: no corpus in $dir" >&2; exit 1; }
  exists "$from" || { echo "eval: no database $from" >&2; exit 1; }
  harness pull --corpus "$dir" --url "jdbc:postgresql://localhost:5432/$from" \
    --runs "$main/.local/eval/runs" "${rest[@]}"
}

case $1 in
  capture) shift; capture "$@" ;;
  pull) shift; pull "$@" ;;
  order) shift; order "$@" ;;
  score) shift; score "$@" ;;
  compare) shift; compare "$@" ;;
  inputs) shift; inputs "$@" ;;
  determinism) shift; determinism "$@" ;;
  run) shift; run "$@" ;;
  *) usage ;;
esac
