#!/usr/bin/env bash
# The eval harness (eval/harness/README.md), run with mill out of the loop: mill builds the
# launcher and exits, then java runs the harness directly.
#
# Every price is shown in cents (Cost.cents); --max-budget-usd is given in USD.
#
#   scripts/eval capture --from <database> [--date <yyyymmdd>]
#       A capture of <database>'s heard messages, in .local/eval/capture/<date>/ (date: today,
#       UTC). The first run dumps <database> (pg_dump -Fc, an MVCC read beside a running
#       engine: source.dump, and its sha256 and time in dump.txt, written once it is restored) and restores it to
#       grit_eval_<date>, which must not exist yet; a later run reuses both. Each run then
#       writes capture.json and cases.jsonl, turns.jsonl (every turn the database recorded,
#       TUI and Slack, by workflow: its offer and the shape its recipe decided, what its
#       weigh step recorded, its window by part and the documents it held, rounds, ending, spend
#       and draft's outcome) and verdicts.json (the review verdicts standing), all text-free,
#       and prints counts. Rerun over the same
#       restored database by the same build, it writes the same bytes. A failed restore's
#       errors, which can quote rows, go to .local/eval/review/restore-<date>.log.
#
#   scripts/eval context <workflow-id | heard-entry-id> --from <database> [--full] [--limit <tokens>]
#                        [--capture <yyyymmdd>]
#       One recorded turn as its model was sent it, text and all, written to
#       .local/eval/review/context-<workflow-id>.md for a person to read: how it got there
#       (the stitch placement and the state its classifier saw, triage's tags, the speech
#       decision and its judgement, the queries and window, every ledger row), then each
#       model call's request rebuilt from the turn's recorded inputs (prompt fragments, tool
#       set, pinned profile, window, entries) through this build's code, each call's estimate
#       against its ledger row and its cache (its share read, its misses priced as cache
#       reads, the prefix re-sent, its fresh tokens), the answer and the summary; then where
#       the input went: the turn's cache, each call's input by part scaled to the provider's
#       count, and what nothing later pointed back at (a proxy, not proof). The epoch the turn
#       ran under is shown beside this build's. Tool results are cut at 4,000 characters unless
#       --full. Reads <database> through read-only sessions; prints counts, never text. With
#       --limit, each call's input and the reserve the loop keeps beside it are printed against
#       that input limit, and where the loop would end the turn (TurnLoop.Rounds.after).
#       Given a heard message's entry id (in:<conversation>:<ts>) instead: what Jev was asked
#       of it and answered, written to .local/eval/review/context-<entry-id>.md: the stitch
#       state as recorded with its placement, its question as this build words it, and
#       triage's request rebuilt through the shipped builder (triage keeps none), its words
#       for the persona and corpora in .local/eval/capture/<yyyymmdd>/ with --capture
#       (persona.json, knowledge.json), else grit and none, beside the tags triage kept.
#
#   scripts/eval context --conversation <conversation-id> --from <database> [--full]
#                        [--redraw <tokens>]
#       Every turn of one conversation, a task's turns, written to
#       .local/eval/review/context-<conversation-id>.md, each as the line above writes one
#       turn, after what the turns held in the cache, also printed: the task's cache and the
#       longest gap between one call's reply and the next; then a line a turn: whether its
#       window was drawn at a boundary or carried, a boundary's dropped earlier turns flagged
#       DROPPED, its first call's share of input read from the cache and what its misses cost,
#       and how much of what the turn before left in the cache its first call did not read.
#       With --redraw, each boundary's window is drawn afresh by this build's linear assembler
#       at a limit of <tokens> (the window tokens the turns ran under), the turn's first call
#       rebuilt under it, and a table printed and written: per boundary, recorded beside
#       redrawn, the earlier turns shown, the first call and its task, earlier turns and
#       digest (grit's estimate scaled to the provider's count), the room to the last call
#       and to the input limit, what the earlier turns' summaries would cost appended, and how
#       many of its tool calls name a file the digest lists; each redrawn request is written
#       message by message. No model is called.
#
#   scripts/eval bench --summary
#       Cents per passing trial over grit_bench's trials, by task, harness and model: every
#       trial's cost by grit's rates, failed ones included, over how many passed, and the
#       passing trials' distance from the task's known diff. Read-only; spends nothing. A kept
#       run prints the same after its trial.
#
#   scripts/eval bench --task <name> --known
#   scripts/eval bench --task <name> --model <id> --max-budget-usd <usd> --max-turns <n>
#                      [--harness claude-code
#                       | --harness grit --standing <file> [--max-tokens <n>]
#                                        [--max-memory-gb <n>] [--window-tokens <n>]
#                                        [--work-turns <n>] [--keep-coder] [--dry]]
#       The coder bench (eval/bench/README.md): the frozen task eval/bench/tasks/<name>, in a
#       checkout of its own holding only its base's history. With --known, the task's own
#       commits through its checks, which must pass; nothing is kept.
#       Otherwise a coder runs the task headless under the caps, all three required: <id> the
#       Anthropic API's model id (claude-haiku-5-5); --max-budget-usd the most a run may spend,
#       which it can pass; --max-turns its turns. The trial, its transcript and its diff are kept in
#       grit_bench (created when missing) and .local/bench/blobs/grit_bench/, and printed:
#       tokens per call with cache reads and writes, grit's cost (beside Claude Code's, for its
#       runs), how the run ended, its denials and its checks. The key is ANTHROPIC_API_KEY, from
#       the environment over GRIT_ENV_FILE (the main checkout's .env when unset); a run refuses
#       to start without it. Every run's checkout is removed as it ends; its log,
#       <checkout>.log beside it, keeps the coder's commits and its diff (to 200 KB), and only
#       the newest 60 logs are kept.
#       --harness claude-code (the default): Claude Code (claude on PATH, or $CLAUDE), in a
#       checkout under .local/bench/work/; its budget is Claude Code's own estimate.
#       --harness grit: `grit work`, built from this checkout, in a checkout under
#       ~/.cache/grit-bench/work/, its brief the standing text in <file> (required; a missing or
#       blank file is refused), the rig's account of where it works and the task's brief, its turn
#       kept in grit_bench_coder, dropped and made afresh first; its budget priced by grit's
#       rates as each call answers, the run stopped once it is reached; --max-turns at least 2,
#       its tool rounds; --max-tokens the most a reply writes (8192); --max-memory-gb the most
#       its processes, all those working in its checkout, may hold together (8), the run stopped
#       past it or when the machine has under 1 GB available, in the compile before grit and in
#       the checks alike. --window-tokens and --work-turns set grit's GRIT_WINDOW_TOKENS and GRIT_WORK_TURNS.
#       grit runs the linear assembler. --keep-coder copies grit_bench_coder, once the run
#       ends however it ends, to grit_bench_coder_<yyyymmddhhmmss> (UTC), so the next trial's
#       fresh database does not take its turns with it; the copies are dropped by hand.
#       --dry prints what its first call would send and stops: no key reaches grit, and
#       nothing is spent or kept.
#
#   scripts/eval propose --standing <file> --against <n> --brief <file> --amendments <dir>
#                        [--out <dir>] <trial>…
#       A proposer's evidence checkout (eval/harness's evidence package): the trials of
#       grit_bench whose sessions' ids are <trial>, all of one task and each begun with the
#       standing text in --standing's file, read for the public; --against, the version of its
#       section that text is (bin/kalandra standing prints it), a whole number of 1 or more. Under --out
#       (~/.cache/grit-propose/), a checkout propose-<seconds> holding base/, a clone of the
#       task's base, and evidence/: PROPOSE.md, the brief in --brief's file then a list of what
#       is shown (standing.md named with --against's version); task.md, the task's brief;
#       standing.md; trajectories/<n>.md, each trial's
#       transcript, each system prompt, tool set and message shown once and each tool result
#       cut to 4,000 characters; amendments/<n>.md, each *.md in
#       --amendments in order of name. Refused, writing nothing, when a file holds the bench's
#       grading text, naming an amendment by its file's name without .md. Only the newest 3
#       checkouts are kept. Prints the checkout's path, PROPOSE.md's, and each trajectory's size
#       as shown and how many turns it renders (none: its run's lines alone). No model call.
#
# Its data is the main checkout's .local/eval/, whichever checkout runs it. It never writes
# to the database it dumps.
set -euo pipefail

usage() { sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//' >&2; exit 2; }
[ $# -ge 1 ] || usage

here=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
main=$(cd "$(git -C "$here" rev-parse --path-format=absolute --git-common-dir)/.." && pwd)
cd "$here"

compose() { docker compose --project-directory "$main" exec -T postgres "$@"; }
exists() { [ "$(compose psql -U grit -d postgres -Atc "SELECT 1 FROM pg_database WHERE datname = '$1'")" = 1 ]; }

# `show` prints a PathRef, "ref:v0:<hash>:<path>"; the path is everything after the third colon.
path_of() { ./mill --ticker false show "$1" | tail -1 | tr -d '"' | cut -d: -f4-; }

harness() {
  local launcher
  launcher=$(path_of grit.eval.harness.launcher)
  JAVA_HOME=$(path_of grit.eval.harness.javaHome) "$launcher" "$@"
}

capture() {
  local from= date
  date=$(date -u +%Y%m%d)
  while [ $# -gt 0 ]; do
    case $1 in
      --from) from=$2; shift 2 ;;
      --date) date=$2; shift 2 ;;
      *) usage ;;
    esac
  done
  [ -n "$from" ] || usage
  [[ $date =~ ^[0-9]{8}$ ]] || { echo "eval: --date is yyyymmdd" >&2; exit 2; }
  local dir="$main/.local/eval/capture/$date" restored="grit_eval_$date"
  mkdir -p "$dir"
  if [ ! -f "$dir/dump.txt" ]; then
    if [ -e "$dir/source.dump" ] || exists "$restored"; then
      echo "eval: an earlier capture into $dir did not finish: remove $dir/source.dump and drop $restored" >&2
      exit 1
    fi
    compose pg_dump -U grit -Fc "$from" >"$dir/source.dump"
    # When the dump finished: every row in it was written before then.
    local dumped
    dumped=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    compose createdb -U grit "$restored"
    # pg_restore's errors can quote the rows it was restoring, so they go where only a person
    # reads them.
    local log="$main/.local/eval/review/restore-$date.log"
    mkdir -p "$(dirname "$log")"
    compose pg_restore -U grit -d "$restored" --no-owner --exit-on-error \
      <"$dir/source.dump" 2>"$log" ||
      { echo "eval: pg_restore failed; its errors are in $log" >&2; exit 1; }
    printf 'source=%s\nsha256=%s\nat=%s\n' "$from" \
      "$(sha256sum "$dir/source.dump" | cut -d' ' -f1)" "$dumped" >"$dir/dump.txt"
    echo "dumped $from and restored it to $restored"
  else
    exists "$restored" || { echo "eval: $dir has a dump but $restored is gone" >&2; exit 1; }
    echo "reusing $dir/source.dump, restored in $restored"
  fi
  local source sha at
  source=$(sed -n 's/^source=//p' "$dir/dump.txt")
  [ "$source" = "$from" ] || { echo "eval: $dir was dumped from $source, not $from" >&2; exit 1; }
  sha=$(sed -n 's/^sha256=//p' "$dir/dump.txt")
  at=$(sed -n 's/^at=//p' "$dir/dump.txt")
  harness capture --url "jdbc:postgresql://localhost:5432/$restored" --source "$from" \
    --restored "$restored" --sha256 "$sha" --at "$at" --out "$dir"
}

context() {
  local id=${1:-} from= full= capture= limit=() conversation= redraw=()
  if [ "$id" = --conversation ]; then conversation=${2:-}; id=$conversation; shift; fi
  [ -n "$id" ] && [[ $id != --* ]] || usage
  shift
  while [ $# -gt 0 ]; do
    case $1 in
      --from) from=${2:-}; shift 2 ;;
      --full) full=--full; shift ;;
      --limit) limit=(--limit "${2:-}"); shift 2 ;;
      --redraw) redraw=(--redraw "${2:-}"); shift 2 ;;
      --capture) capture=${2:-}; shift 2 ;;
      *) usage ;;
    esac
  done
  [ -n "$from" ] || usage
  exists "$from" || { echo "eval: no database $from" >&2; exit 1; }
  local out="$main/.local/eval/review/context-$id.md" url="jdbc:postgresql://localhost:5432/$from"
  if [ -n "$conversation" ]; then
    harness context --url "$url" --from "$from" --conversation "$conversation" --out "$out" $full \
      "${redraw[@]}"
  elif [[ $id =~ ^[0-9a-f-]{36}:[0-9]+$ ]]; then
    harness context --url "$url" --from "$from" --workflow "$id" --out "$out" $full "${limit[@]}"
  else
    local declared=()
    if [ -n "$capture" ]; then
      [ -d "$main/.local/eval/capture/$capture" ] || { echo "eval: no capture $capture" >&2; exit 1; }
      declared=(--declared "$main/.local/eval/capture/$capture")
    fi
    harness context --url "$url" --from "$from" --entry "$id" --out "$out" "${declared[@]}"
  fi
}

bench() {
  local known= dry= summary= keep= arm=claude-code tokens= memory= standing= settings=() rest=()
  while [ $# -gt 0 ]; do
    case $1 in
      --summary) summary=1; shift ;;
      --known) known=1; shift ;;
      --dry) dry=1; shift ;;
      --keep-coder) keep=1; shift ;;
      --harness) [ $# -ge 2 ] || usage; arm=$2; shift 2 ;;
      --max-tokens) [ $# -ge 2 ] || usage; tokens=$2; shift 2 ;;
      --max-memory-gb) [ $# -ge 2 ] || usage; memory=$2; shift 2 ;;
      --standing) [ $# -ge 2 ] || usage; standing=$2; shift 2 ;;
      --window-tokens | --work-turns) [ $# -ge 2 ] || usage; settings+=("$1" "$2"); shift 2 ;;
      --task | --model | --max-budget-usd | --max-turns) [ $# -ge 2 ] || usage; rest+=("$1" "$2"); shift 2 ;;
      *) usage ;;
    esac
  done
  [ -z "$keep" ] || { [ "$arm" = grit ] && [ -z "$dry$known" ]; } || usage
  if [ -n "$summary" ]; then
    [ -z "$known$dry$keep$tokens$memory$standing" ] && [ ${#rest[@]} -eq 0 ] && [ ${#settings[@]} -eq 0 ] || usage
    harness bench --summary true --url "jdbc:postgresql://localhost:5432/grit_bench"
    return
  fi
  local common=(--tasks "$here/eval/bench/tasks" --repository "$main")
  if [ -n "$known" ]; then
    harness bench "${common[@]}" --work "$main/.local/bench/work" --known true "${rest[@]}"
    return
  fi
  local db=grit_bench
  export GRIT_ENV_FILE="${GRIT_ENV_FILE:-$main/.env}"
  case $arm in
    claude-code)
      [ -z "$dry" ] && [ -z "$tokens" ] && [ -z "$memory" ] && [ -z "$standing" ] && [ ${#settings[@]} -eq 0 ] || usage
      exists "$db" || compose createdb -U grit "$db"
      harness bench "${common[@]}" --work "$main/.local/bench/work" "${rest[@]}" \
        --claude "${CLAUDE:-$(command -v claude)}" --scout "$main/scripts/scout" \
        --agent "$here/eval/bench/coder.md" \
        --url "jdbc:postgresql://localhost:5432/$db" --blobs "$main/.local/bench/blobs/$db"
      ;;
    grit)
      [ -n "$standing" ] || usage
      # The grit coder's own database, made afresh for each run: the one place it is named.
      compose dropdb -U grit --if-exists grit_bench_coder
      compose createdb -U grit grit_bench_coder
      ./mill --ticker false grit.app.launcher >/dev/null
      local flags=(--harness grit --grit "$(path_of grit.app.launcher)"
        --java-home "$(path_of grit.app.javaHome)" --scout "$main/scripts/scout"
        --standing "$standing"
        --coder-url "jdbc:postgresql://localhost:5432/grit_bench_coder"
        --max-tokens "${tokens:-8192}" --max-memory-gb "${memory:-8}")
      flags+=("${settings[@]}")
      if [ -n "$dry" ]; then
        harness bench "${common[@]}" --work "$HOME/.cache/grit-bench/work" "${rest[@]}" \
          "${flags[@]}" --dry true
      else
        exists "$db" || compose createdb -U grit "$db"
        local status=0
        harness bench "${common[@]}" --work "$HOME/.cache/grit-bench/work" "${rest[@]}" \
          "${flags[@]}" \
          --url "jdbc:postgresql://localhost:5432/$db" --blobs "$main/.local/bench/blobs/$db" ||
          status=$?
        if [ -n "$keep" ]; then
          local kept
          kept="grit_bench_coder_$(date -u +%Y%m%d%H%M%S)"
          compose createdb -U grit -T grit_bench_coder "$kept"
          echo "kept the coder's database as $kept"
        fi
        return "$status"
      fi
      ;;
    *) usage ;;
  esac
}

propose() {
  local standing= against= brief= amendments= out="$HOME/.cache/grit-propose" trials=()
  while [ $# -gt 0 ]; do
    case $1 in
      --standing) [ $# -ge 2 ] || usage; standing=$2; shift 2 ;;
      --against) [ $# -ge 2 ] || usage; against=$2; shift 2 ;;
      --brief) [ $# -ge 2 ] || usage; brief=$2; shift 2 ;;
      --amendments) [ $# -ge 2 ] || usage; amendments=$2; shift 2 ;;
      --out) [ $# -ge 2 ] || usage; out=$2; shift 2 ;;
      --*) usage ;;
      *) trials+=("$1"); shift ;;
    esac
  done
  [ -n "$standing" ] && [ -n "$against" ] && [ -n "$brief" ] && [ -n "$amendments" ] && [ ${#trials[@]} -gt 0 ] || usage
  local IFS=,
  harness propose --trials "${trials[*]}" --standing "$standing" --against "$against" --brief "$brief" \
    --amendments "$amendments" --out "$out" \
    --tasks "$here/eval/bench/tasks" --repository "$main" \
    --url "jdbc:postgresql://localhost:5432/grit_bench" --blobs "$main/.local/bench/blobs/grit_bench"
}

case $1 in
  capture) shift; capture "$@" ;;
  context) shift; context "$@" ;;
  bench) shift; bench "$@" ;;
  propose) shift; propose "$@" ;;
  *) usage ;;
esac
