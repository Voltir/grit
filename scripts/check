#!/usr/bin/env bash
# The test cycle's one command: runs tests and gates, and prints only what needs reading —
# each failing test, every compile error and warning, and one totals line per tier that a
# commit message can quote. The full output of each tier is kept in out/check/<tier>.log.
#
#   scripts/check                                  # the commit gate: unit, law, probes a change
#                                                  # reaches, format, clock, unsafe, docs, lint
#   scripts/check --it                             # the same, and the integration tier
#   scripts/check --probes                         # the same, and every capture probe
#   scripts/check --milestone                      # the gate, every probe, the integration tier
#   scripts/check --milestone --since <rev>        # and the commits touching core and an edge together
#   scripts/check grit.core                        # one module's unit tests (testCached)
#   scripts/check grit.core.speech.SpeechTests     # one suite (testOnly)
#   scripts/check grit.dbos.it                     # an `it` module, through scripts/it
#   scripts/check grit.core.probes                 # one module's capture probes
#   scripts/check grit.core.durable.SeparationTests  # one probe suite, as any suite
#   scripts/check grit.dbos.engine.CloseLiveTests  # one `it` suite: its full name, as above, never
#                                                  # `grit.dbos.it.testOnly <Suite>`
#   scripts/check --no-unused                      # the gate without the -Wunused:all compile
#   scripts/check --only-unused grit.outline       # one module's -Wunused:all compile, alone
#
# Tiers, with no target:
#   unit  ./mill __.test.testCached: reruns a module's suites only when their inputs changed;
#         a failure is never cached. (`__.testCached` would also match the `it` modules.)
#   law   scripts/enola-law.sh.
#   it    with --it: scripts/it __.it.testForked, every live suite rerun.
#   probes  the capture probes (a `probes` module beside `test`: suites compiling probe sources
#         against their module with its own flags) that a change reaches (`reach`, below: a
#         change touching capture syntax), or with --probes every one, __.probes.testCached.
#   tui   scripts/tui-gate, every scenario of the chat in a real pty, when a change reaches
#         the chat (`reach`, below), and always with --milestone.
#   --milestone is --it and --probes together, and tui: the run a milestone closes with.
#   co-change  with --milestone --since REV, last: each commit in REV..HEAD touching both core's
#         main sources (core/<module>/src) and an edge's (enola-intent.yaml's edge-extensions),
#         a change that a new edge would have to make to core too. A report: it never fails.
#   format  scripts/format-check: every source formatted, and none that scalafmt cannot parse
#         (it skips such a file and exits 0), each named, by the pinned native scalafmt
#         (bash scripts/fetch-scalafmt.sh). --no-lint skips it.
#   clock scripts/clock-check: no main source reads the JVM's time or randomness outside
#         grit.core.clock (Instant.now, Clock.system, nanoTime, randomUUID, ...) unless marked
#         `clock-check: <why>`, each named as file:line. --no-lint skips it.
#   unsafe  scripts/unsafe-check: every caps.unsafe use in a tracked source (tests too) has its
#         proof beside it (STYLE.md rule 11), each without one named as file:line. It shows a
#         proof is there, not that it is sound. --no-lint skips it.
#   docs  scripts/doc-length: no Scaladoc over 60 lines unless a comment above it says why
#         (`doc-length: <why>`), each named as file:line. --no-lint skips it.
#   lint  the modules a change reaches (`reach`, below: each holding a changed .scala file and
#         every module depending on one; all of them when a build file changed) compiled with
#         -Wunused:all (build.mill reads GRIT_LINT=1), in its own output directory, out/lint,
#         so neither cache invalidates the other. Its Mill daemon is shut down when the tier
#         ends. --no-lint or --no-unused skips it; --only-unused runs it alone, over every
#         module; with targets, each target's module and its tests and nested modules.
# A target runs just that: no law, no format, no clock, no unsafe, no docs, no lint, unless
# --only-unused runs lint for its modules. --it, --probes or --milestone with a target is a
# usage error.
# --only-unused runs lint alone, so it conflicts with --no-lint, --no-unused, --it, --probes
# and --milestone.
#
# Exits non-zero when any tier had a failed test, a compile error, a warning, a law failure
# or a timeout. Every tier runs even after an earlier one fails. When Mill fails, the totals
# line does not claim a passed count: a run cut short by a compile error or a timeout has
# fewer tests, not fewer failures.
#
# --timeout DUR bounds each tier's Mill call (a timeout(1) duration; default 20m). On expiry
# the tier's Mill daemon is shut down, which stops the test JVMs it forked.
set -euo pipefail

cd "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() { sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//' >&2; exit 2; }

timeout=20m it=false probes=false lint=true unused=true only=false milestone=false since="" targets=()
while [ $# -gt 0 ]; do
  case $1 in
    --since) [ $# -ge 2 ] || usage; since=$2; shift 2 ;;
    --since=*) since=${1#*=}; shift ;;
    --timeout) [ $# -ge 2 ] || usage; timeout=$2; shift 2 ;;
    --timeout=*) timeout=${1#*=}; shift ;;
    --it) it=true; shift ;;
    --probes) probes=true; shift ;;
    --milestone) it=true probes=true milestone=true; shift ;;
    --no-lint) lint=false; shift ;;
    --no-unused) unused=false; shift ;;
    --only-unused) only=true; shift ;;
    -h|--help) usage ;;
    -*) echo "check: unknown option $1" >&2; usage ;;
    *) targets+=("$1"); shift ;;
  esac
done
if [ ${#targets[@]} -gt 0 ] && { $it || $probes; }; then
  echo "check: --it, --probes and --milestone run whole tiers; name a module or suite instead" >&2
  exit 2
fi
if [ -n "$since" ] && ! $milestone; then
  echo "check: --since reports a milestone's co-changes; use it with --milestone" >&2
  exit 2
fi
if $only && { ! $lint || ! $unused || $it || $probes; }; then
  echo "check: --only-unused runs the lint tier alone; drop --no-lint, --no-unused, --it, --probes or --milestone" >&2
  exit 2
fi

logs=out/check
mkdir -p "$logs"
mill=(./mill --color false --ticker false -k)
totals=() status=0

# A module's folder is <group>/<name>, or the group alone for kit and eval, and the module is
# grit.<name> (build.mill's Placed): core/core is grit.core, extensions/tui/examples is
# grit.tui.examples, kit is grit.kit, eval/harness is grit.eval.harness. Its tier is which of
# test/src, it/src or probes/src it has.
groups=(core extensions kit deployments eval dev)
module_of() { # folders, one per line -> module names
  sed -E 's#^(core|extensions|deployments|dev)/##; s#/#.#g; s#^#grit.#'
}

modules_of() { # tier -> module names, one per line
  find "${groups[@]}" -type d -path "*/$1/src" | sed -E "s#/$1/src\$##" | module_of | sort
}

# A suite's module and tier, from the one source file declaring it: <Name>.scala under a
# {test,it,probes}/src whose package clauses, joined, are the suite's package.
locate_suite() { # fqcn -> "module tier"
  local fqcn=$1 name=${1##*.} pkg=${1%.*} f found=()
  while IFS= read -r f; do
    [ "$(sed -nE 's/^package ([A-Za-z0-9_.]+).*/\1/p' "$f" | paste -sd.)" = "$pkg" ] &&
      grep -qE "^(private )?object $name\b" "$f" && found+=("$f")
  done < <(find "${groups[@]}" \( -path '*/test/src/*' -o -path '*/it/src/*' -o -path '*/probes/src/*' \) \
    -name "$name.scala")
  if [ ${#found[@]} -ne 1 ]; then
    echo "check: $fqcn: ${#found[@]} sources declare it${found:+ (${found[*]})}" >&2
    return 1
  fi
  local t folder
  for t in test it probes; do
    folder=${found[0]%%/$t/src/*}
    [ "$folder" != "${found[0]}" ] && { echo "$(module_of <<<"$folder") $t"; return; }
  done
}

# Prints a tier's failing tests from its fresh reports, its compile errors and warnings from
# its log, and its totals line (appended to $totals via stdout's last line).
summarise() { # tier log rc start report...
  python3 - "$@" <<'PY'
import os, re, sys, xml.etree.ElementTree as ET
tier, log, rc, start, reports = sys.argv[1], sys.argv[2], int(sys.argv[3]), float(sys.argv[4]), sys.argv[5:]
out = []
passed = failed = 0
counted = 0
for path in reports:
    if not os.path.exists(path):
        continue
    fresh = os.path.getmtime(path) >= start
    root = ET.parse(path).getroot()
    for case in root.iter("testcase"):
        bad = case.find("failure") if case.find("failure") is not None else case.find("error")
        if bad is None:
            passed += 1
            continue
        failed += 1
        if not fresh:
            continue
        out.append(f"FAIL {case.get('classname')} > {case.get('name')}")
        text = (bad.get("message") or "").strip().splitlines()[:6]
        out += ["  " + l for l in text]
        frame = next((l.strip() for l in (bad.text or "").splitlines()
                      if l.strip().startswith("at grit.")), None)
        if frame:
            out.append("  " + frame)
    counted += 1

lines = open(log, errors="replace").read().splitlines() if os.path.exists(log) else []
errors = warnings = 0
i = 0
while i < len(lines):
    m = re.match(r"\[(error|warn)\] (.*)", lines[i])
    if not m:
        i += 1
        continue
    kind, rest = m.groups()
    if re.search(r"tests? failed|task failed|Compilation failed|errors? found|warnings? found", rest):
        i += 1
        continue
    if kind == "warn":
        warnings += 1
    else:
        errors += 1
    block = [lines[i]]
    i += 1
    if re.match(r"\S+\.scala:\d+:\d+", rest):  # a compiler diagnostic: its source and message
        while i < len(lines) and not lines[i].startswith("[") and not re.match(r"(compiling|done compiling)", lines[i]):
            if lines[i].strip() or (block[-1].strip() and len(block) > 1):
                block.append(lines[i])
            i += 1
        while block and not block[-1].strip():
            block.pop()
    out += block[:15]

timed_out = rc == 124
# enola's verdict: the regressions block, up to the next blank line.
regressions = next((k for k, l in enumerate(lines) if l.startswith("Regressions (fail):")), None)
if tier == "law" and rc != 0 and regressions is not None:
    end = next((k for k in range(regressions + 1, len(lines)) if not lines[k].strip()), len(lines))
    out += lines[regressions:end][:30]
elif timed_out or (rc != 0 and failed == 0 and errors == 0 and warnings == 0):
    out.append(f"-- last lines of {log}:")
    out += ["  " + l for l in lines[-20:]]
for l in out:
    print(l)

def n(k, word):
    return f"{k} {word}{'' if k == 1 else 's'}"
parts = []
if failed: parts.append(f"{failed} failed")
if errors: parts.append(n(errors, "error"))
if warnings: parts.append(n(warnings, "warning"))
if timed_out:
    total = f"{tier}: TIMED OUT" + (f", {', '.join(parts)}" if parts else "")
elif rc != 0 or failed or errors or warnings:
    total = f"{tier}: FAILED" + (f", {', '.join(parts)}" if parts else f", exit {rc}")
elif reports:
    total = f"{tier}: {passed} passed, 0 failed ({n(counted, 'module')})"
else:
    total = f"{tier}: passed"
print(total)
PY
}

# Appends one line per tier run to check-times.tsv in the repository's common git directory,
# shared by every worktree, so how long the gates take can be read back later: when (UTC),
# checkout, commit, tier, targets ("-" for the whole gate), wall seconds, exit code. A failed
# write never fails the gate.
times=$(git rev-parse --git-common-dir 2>/dev/null)/check-times.tsv
record_time() { # tier seconds rc
  local what=${targets[*]:-"-"}
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(date -u +%FT%TZ)" "$(basename "$PWD")" \
    "$(git rev-parse --short HEAD 2>/dev/null)" "$1" "$what" "$2" "$3" >>"$times" 2>/dev/null || true
}

# Runs one tier: its command under the timeout into its log, then its summary. The tier's
# Mill daemon lives in MILL_OUTPUT_DIR (default out).
run_tier() { # tier outdir reports-file -- command...
  local tier=$1 outdir=$2 reports=$3 log="$logs/$1.log" rc=0 start summary
  shift 4
  echo "== $tier: $*"
  start=$(date +%s)
  timeout "$timeout" "$@" >"$log" 2>&1 || rc=$?
  record_time "$tier" "$(( $(date +%s) - start ))" "$rc"
  if [ "$rc" = 124 ]; then
    echo "$tier: timed out after $timeout; shutting down its Mill daemon" >>"$log"
    MILL_OUTPUT_DIR=$outdir ./mill shutdown >>"$log" 2>&1 || true
  fi
  local -a paths=()
  [ -n "$reports" ] && mapfile -t paths <"$reports"
  summary=$(summarise "$tier" "$log" "$rc" "$start" "${paths[@]}")
  printf '%s\n' "$summary"
  totals+=("$(tail -1 <<<"$summary")")
  case ${totals[-1]} in *FAILED*|*"TIMED OUT"*) status=1 ;; esac
  [ "$rc" = 0 ] || status=1
}

# What a change reaches, from the files it touches since the merge base with main (committed,
# uncommitted and untracked; with no main, everything) and build.mill's module graph
# (`grit.moduleGraph`); CHECK_BASE=<commit> names another base. Prints three lines, each a tier's name and its Mill arguments, `+`-joined,
# or the name alone when the change reaches nothing there:
#   lint    each module holding a changed .scala file, and every module depending on one;
#           every module (__.compile) when build.mill, .mill-version, .mill-jvm-opts or
#           .scalafmt.conf changed. Any other file (a doc, a script) lints nothing.
#   probes  the probes of each module whose main sources' changed lines touch capture syntax
#           (`^`, `caps.`, `SharedCapability`, `Pure`) or the deployment boundary
#           (`private[grit]`, which the kit's probes pin), and of every probed module depending on
#           one; a probes module whose own sources changed; every probe (__.probes) when
#           build.mill or .mill-version changed, since the probes pin what this compiler rejects.
#   tui     scripts/tui-gate when a change's main sources lie in a module the chat runs on
#           directly (turn, tui, chat, app, kit, models: the stub the scenarios answer from),
#           or it changed tui-gate or a build file. Not every module the chat depends on: that
#           is every module, and the scenarios take minutes.
reach() {
  local base graph
  base=${CHECK_BASE-$(git merge-base HEAD main 2>/dev/null || true)}
  if ! graph=$("${mill[@]}" show grit.moduleGraph 2>"$logs/graph.log"); then
    echo "lint __.compile"
    echo "probes __.probes.testCached"
    echo "tui scripts/tui-gate"
    return
  fi
  python3 - "$base" "$graph" <<'PY'
import json, re, subprocess, sys

base, graph = sys.argv[1], [line.split() for line in json.loads(sys.argv[2])]
if not base:
    print("lint __.compile")
    print("probes __.probes.testCached")
    print("tui scripts/tui-gate")
    sys.exit()

def git(*args):
    return subprocess.run(["git", *args], capture_output=True, text=True).stdout.splitlines()

folder = {g[0]: g[1] for g in graph}
dependents = {}
for g in graph:
    for d in g[2:]:
        dependents.setdefault(d, set()).add(g[0])

def owner(path):
    held = [m for m, f in folder.items() if path.startswith(f + "/")]
    return max(held, key=lambda m: len(folder[m]), default=None)

def closure(modules):
    seen, todo = set(modules), list(modules)
    while todo:
        for d in dependents.get(todo.pop(), ()):
            if d not in seen:
                seen.add(d)
                todo.append(d)
    return seen

def joined(tasks):
    return " + ".join(sorted(tasks))

untracked = set(git("ls-files", "--others", "--exclude-standard"))
changed = set(git("diff", "--name-only", base)) | untracked
scala = sorted(c for c in changed if c.endswith(".scala"))

if changed & {"build.mill", ".mill-version", ".mill-jvm-opts", ".scalafmt.conf"}:
    print("lint __.compile")
else:
    linted = closure({m for m in map(owner, scala) if m})
    print("lint " + joined(f"{m}.compile" for m in linted))

capture = re.compile(r"\^|caps\.|SharedCapability|\bPure\b|private\[grit\]")
def touches_capture(path):
    if path in untracked:
        lines = open(path, errors="replace").read().splitlines()
    else:
        lines = [l[1:] for l in git("diff", "-U0", base, "--", path)
                 if l[:1] in ("+", "-") and not l.startswith(("+++", "---"))]
    return any(capture.search(l) for l in lines)

if changed & {"build.mill", ".mill-version"}:
    print("probes __.probes.testCached")
else:
    touched, own = set(), set()
    for path in scala:
        m = owner(path)
        if m is None:
            continue
        if m.endswith(".probes"):
            own.add(m)
        elif path.startswith(folder[m] + "/src/") and touches_capture(path):
            touched.add(m)
    probed = {m + ".probes" for m in closure(touched) if m + ".probes" in folder} | own
    print("probes " + joined(f"{m}.testCached" for m in probed))

chat = {"grit.turn", "grit.tui", "grit.chat", "grit.app", "grit.kit", "grit.models"}
mains = {m for m, p in ((owner(p), p) for p in scala) if m and p.startswith(folder[m] + "/src/")}
gate = {"build.mill", ".mill-version", "scripts/tui-gate", "scripts/tui-gate.py"}
print("tui" + (" scripts/tui-gate" if changed & gate or mains & chat else ""))
PY
}

report_path() { # module tier task
  echo "out/$(tr . / <<<"$1")/$2/$3.dest/test-report.xml"
}

lint_tier() { # Mill tasks... -> the lint tier, its daemon in out/lint shut down after
  run_tier lint out/lint "" -- env GRIT_LINT=1 MILL_OUTPUT_DIR=out/lint "${mill[@]}" "$@"
  MILL_OUTPUT_DIR=out/lint ./mill shutdown >>"$logs/lint.log" 2>&1 || true
}

if [ ${#targets[@]} -eq 0 ]; then
  if ! $only; then
    modules_of test | while read -r m; do report_path "$m" test testCached; done >"$logs/unit.reports"
    run_tier unit out "$logs/unit.reports" -- "${mill[@]}" __.test.testCached

    : >"$logs/law.reports"
    run_tier law out "" -- bash scripts/enola-law.sh

    reached=$(reach)
    read -r -a lint_args <<<"$(sed -n 's/^lint//p' <<<"$reached")"
    read -r -a probes_args <<<"$(sed -n 's/^probes//p' <<<"$reached")"
    $probes && probes_args=(__.probes.testCached)
    if [ ${#probes_args[@]} -gt 0 ]; then
      modules_of probes | while read -r m; do report_path "$m" probes testCached; done >"$logs/probes.reports"
      run_tier probes out "$logs/probes.reports" -- "${mill[@]}" "${probes_args[@]}"
    else
      echo "== probes: no change touches capture syntax"
    fi

    if $it; then
      modules_of it | while read -r m; do report_path "$m" it testForked; done >"$logs/it.reports"
      run_tier it out "$logs/it.reports" -- scripts/it "${mill[@]:1}" __.it.testForked
    fi

    tui_args=$(sed -n 's/^tui //p' <<<"$reached")
    $milestone && tui_args=scripts/tui-gate
    if [ -n "$tui_args" ]; then
      run_tier tui out "" -- "$tui_args"
    else
      echo "== tui: no change reaches the chat"
    fi

    if $lint; then
      run_tier format out "" -- scripts/format-check
      run_tier clock out "" -- scripts/clock-check
      run_tier unsafe out "" -- scripts/unsafe-check
      run_tier docs out "" -- scripts/doc-length
    fi
  fi
  if $lint && $unused; then
    $only && lint_args=(__.compile)
    if [ ${#lint_args[@]} -gt 0 ]; then
      lint_tier "${lint_args[@]}"
    else
      echo "== lint: no change reaches a Scala source"
      totals+=("lint: nothing to lint")
    fi
  fi
else
  # Each target becomes a Mill task: a module's whole tests, or its named suites in one
  # testOnly. Unit tasks share one Mill call, it tasks one scripts/it call, `+`-joined.
  declare -A suites=()
  unit_groups=() it_groups=() probes_groups=() lint_mods=()
  : >"$logs/unit.reports"
  : >"$logs/it.reports"
  : >"$logs/probes.reports"
  for t in "${targets[@]}"; do
    if [[ $t =~ ^(.*)\.it$ ]] && modules_of it | grep -qx "${BASH_REMATCH[1]}"; then
      module=${BASH_REMATCH[1]} tier=it suite=
    elif [[ $t =~ ^(.*)\.probes$ ]] && modules_of probes | grep -qx "${BASH_REMATCH[1]}"; then
      module=${BASH_REMATCH[1]} tier=probes suite=
    elif modules_of test | grep -qx "$t"; then
      module=$t tier=test suite=
    elif [[ $t =~ \.[A-Z][A-Za-z0-9_]*$ ]]; then
      read -r module tier < <(locate_suite "$t") || exit 2
      suite=$t
    else
      echo "check: $t is neither a module with tests nor a suite" >&2
      exit 2
    fi
    if $only; then
      lint_mods+=("$module")
      continue
    fi
    if [ -n "$suite" ]; then
      suites[$module.$tier]+=" $suite"
    elif [ "$tier" = it ]; then
      it_groups+=("$module.it.testForked")
      report_path "$module" it testForked >>"$logs/it.reports"
    elif [ "$tier" = probes ]; then
      probes_groups+=("$module.probes.testCached")
      report_path "$module" probes testCached >>"$logs/probes.reports"
    else
      unit_groups+=("$module.test.testCached")
      report_path "$module" test testCached >>"$logs/unit.reports"
    fi
  done
  for key in "${!suites[@]}"; do
    module=${key%.*} tier=${key##*.}
    if [ "$tier" = it ]; then
      it_groups+=("$module.it.testOnly${suites[$key]}")
    elif [ "$tier" = probes ]; then
      probes_groups+=("$module.probes.testOnly${suites[$key]}")
    else
      unit_groups+=("$module.test.testOnly${suites[$key]}")
    fi
    report_path "$module" "$tier" testOnly >>"$logs/$tier.reports"
  done
  [ -s "$logs/test.reports" ] && cat "$logs/test.reports" >>"$logs/unit.reports"
  rm -f "$logs/test.reports"

  joined() { # group... -> Mill arguments, one per line, the groups separated by +
    local g w first=true
    for g in "$@"; do
      $first || echo +
      first=false
      for w in $g; do echo "$w"; done
    done
  }
  if [ ${#unit_groups[@]} -gt 0 ]; then
    mapfile -t args < <(joined "${unit_groups[@]}")
    run_tier unit out "$logs/unit.reports" -- "${mill[@]}" "${args[@]}"
  fi
  if [ ${#probes_groups[@]} -gt 0 ]; then
    mapfile -t args < <(joined "${probes_groups[@]}")
    run_tier probes out "$logs/probes.reports" -- "${mill[@]}" "${args[@]}"
  fi
  if [ ${#it_groups[@]} -gt 0 ]; then
    mapfile -t args < <(joined "${it_groups[@]}")
    run_tier it out "$logs/it.reports" -- scripts/it "${mill[@]:1}" "${args[@]}"
  fi
  if $only; then
    mapfile -t mods < <(printf '%s\n' "${lint_mods[@]}" | sort -u)
    mapfile -t args < <(joined "${mods[@]/%/.__.compile}")
    lint_tier "${args[@]}"
  fi
fi

# The co-change report (--since): never changes the exit status.
co_change() { # rev
  python3 - "$1" <<'PY'
import subprocess, sys
import yaml

rev = sys.argv[1]
components = yaml.safe_load(open("enola-intent.yaml"))["components"]
edges = sorted({p[: -len("/**")] if p.endswith("/**") else p
                for c in components if c["name"] == "edge-extensions" for p in c["match"]})

def git(*args):
    return subprocess.run(["git", *args], capture_output=True, text=True, check=True).stdout.splitlines()

try:
    log = git("log", "--format=%H %h %s", f"{rev}..HEAD")
except subprocess.CalledProcessError:
    print(f"co-change: {rev} is no revision")
    sys.exit()
found = []
for line in log:
    full, short, subject = line.split(" ", 2)
    files = git("show", "--name-only", "--format=", full)
    core = any(f.startswith("core/") and f.split("/")[2:3] == ["src"] for f in files)
    edge = any(f.startswith(e + "/") for f in files for e in edges)
    if core and edge:
        found.append(f"  {short} {subject}")
print(f"co-change: {len(found)} of {len(log)} commits in {rev}..HEAD touch core and an edge together")
for f in found:
    print(f)
PY
}
if [ ${#targets[@]} -eq 0 ] && [ -n "$since" ]; then
  echo "== co-change"
  report=$(co_change "$since" 2>"$logs/co-change.err") || report="co-change: could not be read ($logs/co-change.err)"
  printf '%s\n' "$report" | tee "$logs/co-change.log"
  totals+=("$(head -1 <<<"$report") (reported, not gated)")
fi

echo "== totals"
printf '%s\n' "${totals[@]}"
echo "logs: $logs/"
exit $status
