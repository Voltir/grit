#!/usr/bin/env python3
"""The law's own test: plants a breach of every rule, of the cycle check and of each of
scripts/enola-law.sh's greps, runs the law once over all of them, and passes only when every
plant was caught. The law is run on the clean tree first (it must pass, and it pins a baseline
if none is pinned), the plants are deleted afterwards (on failure too), and the law is run once
more on the clean tree.

    scripts/enola-plant

A rule or a grep naming a path that matches nothing passes silently: enola's "matches
nothing" check sees a dead component, but not a rule whose component lost part of what it
should hold, nor the script's greps. Run this after any change to enola-intent.yaml,
scripts/enola-law.sh or where a module's folder is; a layout change runs it before and after.

Where the plants go is read from the tree, so a layout change needs no edit here:
  rules     enola-intent.yaml's components. Every `forbid_name` rule: one file in core's test
            sources (a member of every outside-* component, and outside the process grep's
            production roots, which its java.lang.ProcessBuilder import would trip) importing
            every forbidden class. Every `allow` rule: one file in its component's first match,
            importing grit.app.main.Main -- a deployment, which ADR 0021 lets no component name.
  cycle     two packages in core's main sources importing each other: enola reports cycles
            between production packages only.
  names     the name greps: each name written fully qualified, with no import (so no edge for
            a rule to see), in the main sources of a module that may not name it: the kit's
            for every name but Mint, which the kit may name, grit.edge's for Mint,
            grit.act's for sanitiser, the downgrade only the integrity tree may make, and
            grit.prose's, outside its json package, for ujson; grit.formats', outside its pdf
            package, for PDFBox.
  unruled   the quarantine grep: one unruled class imported in each of grit.dbos, grit.models,
            grit.mcp, grit.host, grit.slack and grit.formats' sources, each of which it must list.
  process   the process grep: `new ProcessBuilder` with no import in every production source
            root but grit.host's (the outline tool's test fixture's included: a `src` root),
            each of which it must list.
  paths     the component path check: a folder that does not exist added to the last
            component's `match` in enola-intent.yaml, restored after the run.
Each catch is read from its own part of the law's output: a rule from enola's `constraint
<id> violated`, every other kind from the lines under its check's heading.

Exits 0 when every plant was caught, 1 otherwise, 2 when the tree is not as expected.
Plant files need not compile: the law reads source, and nothing here runs Mill.
"""
import fnmatch, os, re, shutil, subprocess, sys

import yaml

ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), ".."))
os.chdir(ROOT)
PLANT = "enolaplant"  # the folder every plant file is written in; never a real package


def fail(msg):
    print(f"enola-plant: {msg}", file=sys.stderr)
    sys.exit(2)


def sources():
    out = subprocess.run(["git", "ls-files", "*.scala"], capture_output=True, text=True, check=True)
    return out.stdout.split()


def package_of(path):
    with open(path, errors="replace") as f:
        parts = [m.group(1) for line in f if (m := re.match(r"package ([A-Za-z0-9_.]+)", line))]
    return ".".join(parts)


def roots(kind):
    """Each source root (`<module folder>/src` for production, `.../test/src`, `.../it/src` and
    `.../probes/src` for test) with the package each of its files declares."""
    found = {}
    for path in sources():
        m = re.match(r"(.+?/src)/", path)
        if not m:
            continue
        root = m.group(1)
        is_test = re.search(r"/(test|it|probes)/src$", root) is not None
        if (kind == "test") == is_test:
            found.setdefault(root, []).append(package_of(path))
    return found


def root_of(package, kind):
    """The source root most of whose files declare `package` or a package under it: a test
    root may hold a file of another module's package (core's tests hold one of grit.dbos)."""
    def ours(p):
        return p == package or p.startswith(package + ".")
    hits = [r for r, pkgs in roots(kind).items() if 2 * sum(map(ours, pkgs)) > len(pkgs)]
    if kind == "test":  # a module's probes are tests too, but its tests' root is test/src
        hits = [r for r in hits if not r.endswith("/probes/src")]
    if len(hits) != 1:
        fail(f"{len(hits)} {kind} source roots are mostly {package}: {hits}")
    return hits[0]


def member(path, component):
    return any(path == g or fnmatch.fnmatchcase(path, g) for g in component["match"])


def write(folder, name, body):
    path = os.path.join(folder, PLANT, name)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        f.write(body)
    return path


def law():
    r = subprocess.run(["bash", "scripts/enola-law.sh"], capture_output=True, text=True)
    return r.returncode, r.stdout + r.stderr


planted = []


def clean():
    for folder in sorted({p[: p.index("/" + PLANT + "/") + len(PLANT) + 1] for p in planted}):
        shutil.rmtree(folder, ignore_errors=True)
    planted.clear()


def plant_rules(intent):
    components = {c["name"]: c for c in intent["components"]}
    rules = intent["rules"]
    core_test = root_of("grit.core", "test")
    forbidden = []
    for rule in rules:
        if "forbid_name" in rule:
            if not member(core_test + "/" + PLANT, components[rule["forbid_name"]]):
                fail(f"{core_test} is not in {rule['forbid_name']}, so {rule['id']} cannot be planted there")
            forbidden.append(rule["pattern"].split(" -> ", 1)[1])
    planted.append(write(core_test, "Quarantine.scala",
                         "package grit.enolaplant\n\n" + "".join(f"import {c}\n" for c in forbidden)))
    for rule in rules:
        if "allow" in rule:
            folder = components[rule["allow"]]["match"][0]
            if "*" in folder or not os.path.isdir(folder):
                fail(f"{rule['allow']}'s first match {folder} is not a folder")
            name = "".join(w.capitalize() for w in re.split(r"[^A-Za-z0-9]+", rule["id"])) + ".scala"
            planted.append(write(folder, name, "package grit.enolaplant\n\nimport grit.app.main.Main\n"))
    return {r["id"] for r in rules}


CYCLE = {"a": "b", "b": "a"}  # each planted package and the one it imports


def plant_cycle():
    root = root_of("grit.core", "src")
    for pkg, other in CYCLE.items():
        planted.append(write(root, f"{pkg}/{pkg.upper()}.scala",
                             f"package grit.{PLANT}.{pkg}\n\nimport grit.{PLANT}.{other}.{other.upper()}\n\n"
                             f"object {pkg.upper()} {{ def other = {other.upper()} }}\n"))
    return {f"{root}/{PLANT}/{pkg}" for pkg in CYCLE}


# Each name grep's heading in the law's output, the fully qualified use that must trip it, and
# the module whose main sources the use is planted in.
NAMES = {
    "may name LabelParts": ("grit.core.visibility.LabelParts", "grit.kit"),
    "may name IntegrityParts": ("grit.core.visibility.IntegrityParts", "grit.kit"),
    "may name Maintenance": ("grit.core.visibility.Maintenance", "grit.kit"),
    "may name grit.dbos.internal": ("grit.dbos.internal.Reader", "grit.kit"),
    "may name PrincipalIds": ("grit.core.id.PrincipalIds", "grit.kit"),
    "may name Mint": ("grit.core.flow.Mint", "grit.edge"),
    "may name sanitiser": ("grit.core.flow.Downgrade.sanitiser", "grit.act"),
    "may name ujson": ("ujson.Value", "grit.prose"),
    "may name PDFBox": ("org.apache.pdfbox.Loader", "grit.formats"),
}


def plant_names():
    files = {}
    for heading, (name, module) in NAMES.items():
        path = write(root_of(module, "src"), name.rsplit(".", 1)[1] + ".scala",
                     f"package grit.{PLANT}\n\nval named = {name}\n")
        planted.append(path)
        files[heading] = path
    return files


UNRULED = {
    "grit.dbos": "dev.dbos.transact.EnolaPlantDbos",
    "grit.models": "java.net.http.EnolaPlantModels",
    "grit.mcp": "java.net.http.EnolaPlantMcp",
    "grit.host": "scala.sys.process.EnolaPlantHost",
    "grit.slack": "com.slack.api.EnolaPlantSlack",
    "grit.formats": "org.apache.pdfbox.EnolaPlantFormats",
}


def plant_unruled():
    for package, cls in UNRULED.items():
        planted.append(write(root_of(package, "src"), "Unruled.scala",
                             f"package grit.{PLANT}\n\nimport {cls}\n"))
    return set(UNRULED.values())


def plant_process():
    host = root_of("grit.host", "src")
    files = set()
    for root in roots("src"):
        if root != host:
            path = write(root, "Process.scala", f"package grit.{PLANT}\n\nval p = new ProcessBuilder(\"true\")\n")
            planted.append(path)
            files.add(path)
    return files


PATH = PLANT + "/missing"  # the folder the paths plant names, which no checkout holds


def plant_paths():
    """Adds PATH to the last component's `match` in enola-intent.yaml's text; returns the text
    as it was, for restoring, and the line the check must print."""
    with open("enola-intent.yaml") as f:
        text = f.read()
    with open("enola-intent.yaml") as f:
        last = yaml.safe_load(f)["components"][-1]["name"]
    at = text.index("\nrules:")
    head, tail = text[:at], text[at:]
    m = list(re.finditer(r"match: \[", head))[-1]
    with open("enola-intent.yaml", "w") as f:
        f.write(head[: m.end()] + f'"{PATH}", ' + head[m.end():] + tail)
    return text, f"{last}: {PATH}"


def block(output, heading):
    """The lines indented two spaces under the line containing `heading`, stripped."""
    lines = output.splitlines()
    found = set()
    for i, line in enumerate(lines):
        if heading in line and not line.startswith(" "):
            for item in lines[i + 1:]:
                if not item.startswith("  "):
                    break
                found.add(item.strip())
    return found


def report(kind, wanted, caught):
    missed = sorted(set(wanted) - set(caught))
    print(f"{kind}: {len(wanted) - len(missed)} of {len(wanted)} caught" + (f"; missed: {' '.join(missed)}" if missed else ""))
    return not missed


def main():
    with open("enola-intent.yaml") as f:
        intent = yaml.safe_load(f)
    if any(os.path.isdir(os.path.join(r, PLANT)) for kind in ("src", "test") for r in roots(kind)):
        fail(f"a {PLANT}/ folder is already in the tree; delete it first")
    rc, out = law()
    if rc != 0:
        print(out[-3000:])
        fail("the law fails on the clean tree; plants could not be told apart from what is there")
    ok = True
    intent_text = None
    try:
        ids = plant_rules(intent)
        cycle = plant_cycle()
        names = plant_names()
        classes = plant_unruled()
        files = plant_process()
        intent_text, path = plant_paths()
        rc, out = law()
        clean()
        ok &= rc != 0
        ok &= report("rules", ids, set(re.findall(r"constraint (\S+) violated", out)))
        cycled = block(out, "The law fails on any import cycle")
        ok &= report("cycle", cycle, {p for p in cycle if any(p in line for line in cycled)})
        ok &= report("name greps", names.values(),
                     {path for heading, path in names.items() if path in block(out, heading)})
        ok &= report("unruled grep", classes, block(out, "no rule in enola-intent.yaml names"))
        ok &= report("process grep", files, block(out, "Only grit.host may start a process"))
        ok &= report("paths check", {path}, block(out, "A component names a path that is no folder"))
    finally:
        clean()
        if intent_text is not None:
            with open("enola-intent.yaml", "w") as f:
                f.write(intent_text)
    rc, out = law()
    print("law on the clean tree: " + ("passed" if rc == 0 else "FAILED"))
    if rc != 0:
        print(out[-3000:])
    sys.exit(0 if ok and rc == 0 else 1)


main()
