#!/usr/bin/env bash
# Publishes every published module (build.mill's GritPublished) to the local ivy repository,
# all at the one version build.mill names. That version is one of two kinds:
#
#   X.Y.Z-SNAPSHOT  a snapshot, while a milestone's work is landing: published again as grit
#                   changes, each run replacing the snapshot already in the repository whole
#   X.Y.Z           a release, at a milestone's close: set in its own commit, tagged v<version>,
#                   and published once; a later fix is the next patch version, never a republish
#
#   scripts/publish-local                 # publish, or say every reason it will not
#   scripts/publish-local --check         # every refusal, and what would be published; publishes nothing
#   scripts/publish-local --repo DIR      # into DIR in place of ~/.ivy2/local
#
# Refuses, naming each reason, when the version is of neither kind; when a tracked file is
# modified or staged, or an untracked or ignored .scala, .java or resources file sits under a
# module folder (Mill would compile it into the jars; other untracked files do not count); when
# HEAD is not an ancestor of origin/main as last fetched (either kind names a commit of main);
# and when a Mill query fails. A release is refused too when HEAD is not tagged v<version>, and
# when any module already has that version in the repository. A snapshot is refused too when a
# .publish-local.* scratch directory sits beside the repository (a run was killed mid-move, or
# another is running).
#
# A snapshot's commit is kept in one marker, <repo>/dev.grit/.publish-local-<version>, holding
# the full hash of the commit it was published from; --check prints it. A release has none: its
# tag names its commit.
#
# It publishes into a scratch repository beside the repository, on the same filesystem, checks
# that every module is there, then moves each module's version directory in by rename, a
# snapshot's previous one first moved aside into the scratch repository, and last renames the
# marker in.
#
# A failure the script can catch leaves the repository as it found it: a failed move, or an INT
# or TERM during the move, moves back every version directory already moved in (removing one
# that cannot be moved back), moves each previous snapshot module and the previous marker back,
# exits non-zero, and says so on stderr. A kill -9 or a power loss mid-move can leave a partial
# version: some modules' <version> directories in the repository and not others, and a
# .publish-local.* scratch directory beside it, which holds any previous snapshot modules moved
# aside. --check then refuses, naming the modules that hold the version. To clear it by hand,
# remove each <repo>/dev.grit/<artifact>/<version> directory it names, the marker
# <repo>/dev.grit/.publish-local-<version> if there is one, and each .publish-local.* directory
# beside <repo>; the next run then publishes the version.
set -euo pipefail

cd "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

check=false
repo="$HOME/.ivy2/local"
while [ $# -gt 0 ]; do
  case "$1" in
    --check) check=true ;;
    --repo)
      [ $# -ge 2 ] || { echo "publish-local: --repo takes a directory" >&2; exit 2; }
      repo="$2"
      shift
      ;;
    -h | --help)
      sed -n '2,/^set -euo/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *) echo "publish-local: unknown argument $1 (see --help)" >&2; exit 2 ;;
  esac
  shift
done

errlog=$(mktemp)
scratch=""
keep_scratch=false
moving=false

# Puts the repository back as this run found it. A module whose new version directory is out of
# the scratch repository was moved in, and is moved back (removed if it cannot be; reported if it
# cannot be removed); a previous snapshot module moved aside is moved back, as is the previous
# marker. A previous module that cannot be moved back stays in the scratch repository, which is
# then kept, and is reported with its path.
undo_moves() {
  local a in_repo new old left=() kept=()
  for a in $artifacts; do
    in_repo="$repo/dev.grit/$a/$version"
    new="$scratch/dev.grit/$a/$version"
    old="$scratch/previous/$a"
    if [ ! -e "$new" ] && [ -e "$in_repo" ]; then
      if ! { mkdir -p "$scratch/dev.grit/$a" && mv -T "$in_repo" "$new"; }; then
        if rm -rf "$in_repo"; then
          echo "publish-local: could not move $a back to $scratch; removed $in_repo" >&2
        else
          left+=("$in_repo")
        fi
      fi
    fi
    if [ -e "$old" ] && ! mv -T "$old" "$in_repo"; then kept+=("$old"); fi
  done
  if [ -e "$scratch/previous.marker" ]; then
    mv -T "$scratch/previous.marker" "$marker" || kept+=("$scratch/previous.marker")
  elif [ "$kind" = snapshot ]; then
    rm -f "$marker" || left+=("$marker")
  fi
  if [ ${#kept[@]} -gt 0 ]; then
    keep_scratch=true
    echo "publish-local: could not move back the previous $version, kept here: ${kept[*]}" >&2
  fi
  if [ ${#left[@]} -gt 0 ]; then
    echo "publish-local: could not undo the partial move; still in the repository: ${left[*]}" >&2
  fi
  if [ ${#kept[@]} -eq 0 ] && [ ${#left[@]} -eq 0 ]; then
    echo "publish-local: undid the partial move; $repo/dev.grit holds the $version it held before" >&2
  fi
  return 0
}

cleanup() {
  local status=$?
  trap - EXIT INT TERM
  if $moving; then undo_moves; fi
  if [ -n "$scratch" ] && ! $keep_scratch; then rm -rf "$scratch"; fi
  rm -f "$errlog"
  exit "$status"
}
trap cleanup EXIT
trap 'echo "publish-local: interrupted" >&2; exit 130' INT
trap 'echo "publish-local: terminated" >&2; exit 143' TERM

# mill_query WHAT ARGS...: sets $answer to Mill's stdout. On failure, refuses, naming WHAT and
# the end of Mill's stderr.
mill_query() {
  local what=$1 detail
  shift
  if answer=$(./mill --color false --ticker false "$@" 2>"$errlog"); then
    return 0
  fi
  detail=$(tail -n 3 "$errlog" | paste -sd' ' -)
  echo "publish-local: refused, publishing nothing: Mill failed $what${detail:+: $detail}" >&2
  exit 1
}

mill_query "reading build.mill's publishVersion" show grit.core.publishVersion
version=$(echo "$answer" | tr -d '"[:space:]')
mill_query "listing the published modules" resolve __.publishVersion
modules=$(echo "$answer" | sed 's/\.publishVersion$//' | sort)
[ -n "$modules" ] || { echo "publish-local: Mill listed no published module" >&2; exit 1; }
selector="{$(echo "$modules" | sed 's/^grit\.//' | paste -sd, -)}"
mill_query "naming the artifacts" show "grit.$selector.artifactId"
artifacts=$(echo "$answer" | sed -n 's/^ *"[^"]*": *"\([^"]*\)",\{0,1\}$/\1/p' | sort)
[ "$(echo "$artifacts" | wc -l)" -eq "$(echo "$modules" | wc -l)" ] ||
  { echo "publish-local: Mill named no artifact for some published module" >&2; exit 1; }
marker="$repo/dev.grit/.publish-local-$version"

refusals=()
kind=""
if [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  kind=release
elif [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+-SNAPSHOT$ ]]; then
  kind=snapshot
else
  refusals+=("the version is $version, neither a release X.Y.Z nor a snapshot X.Y.Z-SNAPSHOT")
fi
dirty=$(git status --porcelain --untracked-files=no)
if [ -n "$dirty" ]; then
  refusals+=("tracked files are modified or staged: $(echo "$dirty" | awk '{print $NF}' | paste -sd' ' -)")
fi
source_roots=(core extensions kit deployments eval)
untracked=$(git ls-files --others --exclude-standard -- "${source_roots[@]}")
ignored=$(git ls-files --others --ignored --exclude-standard -- "${source_roots[@]}")
sources=$(printf '%s\n%s\n' "$untracked" "$ignored" | grep -E '(\.scala|\.java)$|(^|/)resources/' | sort -u || true)
if [ -n "$sources" ]; then
  count=$(echo "$sources" | wc -l)
  shown=$(echo "$sources" | head -n 5 | paste -sd' ' -)
  more=""
  if [ "$count" -gt 5 ]; then more=" (and $((count - 5)) more)"; fi
  refusals+=("untracked or ignored sources under a module folder would be compiled into the jars: $shown$more")
fi
head=$(git rev-parse HEAD)
short=$(git rev-parse --short HEAD)
if [ "$kind" != snapshot ]; then
  tagged=$(git rev-parse -q --verify "refs/tags/v$version^{commit}" || true)
  if [ -z "$tagged" ]; then
    refusals+=("HEAD ($short) is not tagged v$version: tag the commit to publish first")
  elif [ "$tagged" != "$head" ]; then
    refusals+=("v$version tags $(git rev-parse --short "$tagged"), not HEAD ($short)")
  fi
fi
if ! git rev-parse -q --verify origin/main >/dev/null; then
  refusals+=("there is no origin/main to hold HEAD")
elif ! git merge-base --is-ancestor HEAD origin/main; then
  refusals+=("HEAD ($short) is not on origin/main as last fetched")
fi
published=()
for a in $artifacts; do
  if [ -e "$repo/dev.grit/$a/$version" ]; then published+=("$a"); fi
done
if [ "$kind" = snapshot ]; then
  stale=$(compgen -G "$(dirname "$repo")/.publish-local.*" | paste -sd' ' - || true)
  if [ -n "$stale" ]; then
    refusals+=("$stale beside $repo: a run was killed mid-move or is running; if none is running, clear by hand each $version directory of ${published[*]:-no module} under $repo/dev.grit, $marker, and $stale")
  fi
elif [ ${#published[@]} -gt 0 ]; then
  refusals+=("$version is in $repo/dev.grit already, for ${published[*]}: a fix is the next patch version")
fi

# What the repository holds of this snapshot now: the commit its marker names, or that it has
# none.
if $check && [ "$kind" = snapshot ]; then
  if [ -f "$marker" ]; then
    from=$(head -n 1 "$marker")
    named=$(git log -1 --format='%h %s' "$from" 2>/dev/null || echo "$from, a commit this clone lacks")
    if [ -n "$stale" ]; then
      echo "publish-local: the $version in $repo/dev.grit may be partial; its marker names $named"
    else
      echo "publish-local: the $version in $repo/dev.grit was published from $named"
    fi
  elif [ ${#published[@]} -gt 0 ]; then
    echo "publish-local: the $version in $repo/dev.grit has no marker, so names no commit: ${published[*]}"
  else
    echo "publish-local: $repo/dev.grit holds no $version"
  fi
fi

if [ ${#refusals[@]} -gt 0 ]; then
  echo "publish-local: refused, publishing nothing:" >&2
  printf '  - %s\n' "${refusals[@]}" >&2
  exit 1
fi

if $check; then
  replacing=""
  if [ ${#published[@]} -gt 0 ]; then replacing=", replacing the $version there"; fi
  echo "publish-local: would publish $version of $(echo "$artifacts" | wc -l) modules from $short into $repo/dev.grit$replacing:"
  echo "$artifacts" | sed 's/^/  /'
  exit 0
fi

mkdir -p "$repo/dev.grit"
scratch=$(mktemp -d "$(dirname "$repo")/.publish-local.XXXXXX")
if [ "$(stat -c %d "$scratch")" != "$(stat -c %d "$repo/dev.grit")" ]; then
  echo "publish-local: $scratch is not on $repo's filesystem; publishing nothing" >&2
  exit 1
fi

./mill --color false --ticker false __.publishLocal --local-ivy-repo "$scratch"
missing=()
for a in $artifacts; do
  [ -f "$scratch/dev.grit/$a/$version/ivys/ivy.xml" ] || missing+=("$a")
done
if [ ${#missing[@]} -gt 0 ]; then
  echo "publish-local: not published, so nothing moved into $repo: ${missing[*]}" >&2
  exit 1
fi

if [ -e "$marker" ]; then cp -p "$marker" "$scratch/previous.marker"; fi
mkdir -p "$scratch/previous"
moved=()
moving=true
for a in $artifacts; do
  in_repo="$repo/dev.grit/$a/$version"
  if [ -e "$in_repo" ] && ! mv -T "$in_repo" "$scratch/previous/$a"; then
    echo "publish-local: moving the previous $a aside failed; undoing the ${#moved[@]} moved" >&2
    exit 1
  fi
  if mkdir -p "$repo/dev.grit/$a" && mv -T "$scratch/dev.grit/$a/$version" "$in_repo"; then
    moved+=("$a")
  else
    echo "publish-local: moving $a failed; undoing the ${#moved[@]} moved" >&2
    exit 1
  fi
done
if [ "$kind" = snapshot ]; then
  echo "$head" >"$scratch/marker"
  mv -T "$scratch/marker" "$marker"
fi
moving=false
if [ "$kind" = snapshot ]; then
  echo "publish-local: published $version of ${#moved[@]} modules into $repo/dev.grit, from $(git log -1 --format='%h %s' HEAD)"
else
  echo "publish-local: published $version of ${#moved[@]} modules into $repo/dev.grit, from v$version ($short)"
fi
