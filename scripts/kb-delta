#!/usr/bin/env python3
"""What a range of commits did to the size of grit's Scala, in KB, split three ways:
production code, production comments, and tests (the `test`, `it` and `probes` trees, comments
included). A number to read beside a change, never a target: a change that adds a feature
grows the tree, and one that replaces something should show what it took out.

  scripts/kb-delta main..HEAD     # a branch against main
  scripts/kb-delta HEAD~3..HEAD   # the last three commits

A comment is a `/* ... */` block or a line that starts with `//`. Files other than `.scala`
are not counted.
"""
import re
import subprocess
import sys


def git(*args: str) -> str:
    return subprocess.run(["git", *args], capture_output=True, text=True, check=True).stdout


def split(text: str) -> tuple[int, int]:
    """(code bytes, comment bytes) of one source's text."""
    code = comment = 0
    in_block = False
    for line in text.split("\n"):
        size = len(line.encode()) + 1
        start = line.strip()
        if in_block or start.startswith("/*") or start.startswith("//"):
            comment += size
            if start.startswith("//") and not in_block:
                continue
            in_block = "*/" not in line
        else:
            code += size
    return code, comment


def sizes(rev: str, path: str) -> tuple[int, int]:
    try:
        return split(git("show", f"{rev}:{path}"))
    except subprocess.CalledProcessError:
        return 0, 0


def main() -> int:
    if len(sys.argv) != 2 or ".." not in sys.argv[1]:
        print(__doc__, file=sys.stderr)
        return 2
    base, head = sys.argv[1].split("..", 1)
    base = git("merge-base", base, head or "HEAD").strip()
    head = head or "HEAD"
    totals = {"production code": 0, "production comments": 0, "tests": 0}
    for path in git("diff", "--name-only", base, head, "--", "*.scala").split("\n"):
        if not path:
            continue
        (code0, doc0), (code1, doc1) = sizes(base, path), sizes(head, path)
        if re.search(r"/(test|it|probes)/", path):
            totals["tests"] += (code1 + doc1) - (code0 + doc0)
        else:
            totals["production code"] += code1 - code0
            totals["production comments"] += doc1 - doc0
    print(" · ".join(f"{name} {delta / 1024:+.1f} KB" for name, delta in totals.items()))
    return 0


if __name__ == "__main__":
    sys.exit(main())
