#!/usr/bin/env bash
# The outline tool's `show` query, run from the caller's checkout (grit's TASTy query tool, dev/outline).
#
# Builds are kept outside every checkout, in ${XDG_CACHE_HOME:-~/.cache}/grit-outline, one per version of
# outline's own sources: <key> is a hash of dev/outline's files and the build definition lines that make
# the module, so every worktree on the same outline code runs one build, and a branch that changes outline
# gets its own. A key's build (run, classes, java_home.txt) is never rewritten once kept; neither a rebuild
# nor `./mill clean` reaches it. A key with no build is built first, then kept; keys unused for 7 days are
# removed at start.
#
# The build runs without a daemon in its own output directory, out/outline. Built in out/ itself, a
# no-daemon run replaces the compiler worker that out/'s warm daemon is connected to (Mill keeps one
# per JDK under out/mill.javalib.JvmWorkerModule) and takes it down when it exits, so that daemon's
# next compile fails with "Connection refused" until `./mill shutdown`. outline's Mill layout skips
# out/outline, as it does any nested Mill output directory.
#
#   scripts/outline show Moves.ask
#   scripts/outline show Ask.score --depth 2
set -euo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
root=$(git rev-parse --show-toplevel 2>/dev/null || echo "$here")

dir="$here/out/outline/grit/outline"
launcher="$dir/launcher.dest/run"
java_home_file="$dir/java_home.txt"

build_mill() { (cd "$here" && MILL_OUTPUT_DIR=out/outline ./mill --no-daemon --ticker false "$@"); }

# `show` prints a PathRef, "ref:v0:<hash>:<path>"; the path is everything after the third colon.
path_of() { build_mill show "$1" | tail -1 | tr -d '"' | cut -d: -f4-; }

# The key of this checkout's outline sources: every file under dev/outline, by path and content, and the
# lines of build.mill that define the module (Placed, GritModule, the outline object), and .mill-version.
outline_key() {
  {
    (cd "$here" && find dev/outline -type f -print0 | LC_ALL=C sort -z | xargs -0 sha256sum)
    awk '/^trait Placed /,/^}$/; /^trait GritModule /,/^}$/; /^  object outline /,/^  }$/' "$here/build.mill"
    cat "$here/.mill-version"
  } | sha256sum | cut -c1-16
}

base="${XDG_CACHE_HOME:-$HOME/.cache}/grit-outline"
key=$(outline_key)
cache="$base/$key"
last="$base/last"
mkdir -p "$base/locks"
lock="$base/locks/$(printf '%s' "$here" | sha256sum | cut -c1-16).lock"

# The cache's log: each MCP server's life (who started it, its stderr, what removed which snapshot, how it
# ended), the background builds, and what the cleanup removed. The client shows a server's stderr only
# when it fails to connect, so a server that dies later says why nowhere else. The log is cut to its last
# 2000 lines at each MCP start.
log="$base/mcp.log"
log_line() { printf '%s [%s] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%S.%3NZ)" "$$" "$*" >> "$log"; }
note() { :; }
if [ "${1:-}" = mcp ] || [ "${1:-}" = --build-behind ]; then
  note() { log_line "$@"; }
fi
if [ "${1:-}" = mcp ]; then
  if [ -f "$log" ] && [ "$(wc -l < "$log")" -gt 2000 ]; then
    tail -n 2000 "$log" > "$log.$$" && mv "$log.$$" "$log"
  fi
  parent=$(tr '\0' ' ' < "/proc/$PPID/cmdline" 2>/dev/null || echo '?')
  parent=${parent% }
  note "invoked: root $root, key $key, parent $PPID ${parent:0:200}"
  for s in INT TERM HUP; do trap "note \"got SIG$s before the server started\"; exit $((128 + $(kill -l $s)))" "$s"; done
  trap 'st=$?; note "ended with status $st before the server started"' EXIT
fi

# Keys not used for 7 days, other than this one, are removed, and so said in the log.
for old in "$base"/*/; do
  old=${old%/}
  name=${old##*/}
  case "$name" in mcp | locks | "$key") continue ;; esac
  [ -L "$old" ] && continue
  stamp="$old/used"
  [ -e "$stamp" ] || stamp="$old"
  if [ -z "$(find "$stamp" -maxdepth 0 -mtime -7 2>/dev/null)" ]; then
    log_line "removing build $name: unused since $(date -u -r "$stamp" +%Y-%m-%dT%H:%MZ)"
    rm -rf "${base:?}/$name"
  fi
done

# Builds the launcher in this checkout and keeps it as this key's build; Mill's output goes to stdout. The
# returns are explicit, since a caller testing the status turns `set -e` off inside. A source changed
# during the build changes the key, and that build is not kept.
build_and_keep() {
  build_mill grit.outline.launcher || return
  mkdir -p "$dir" || return
  path_of grit.outline.javaHome > "$java_home_file" || return
  local now
  now=$(outline_key) || return
  if [ "$now" != "$key" ]; then
    echo "outline: a source changed during the build, so it is not kept as $key"
    return 0
  fi
  [ -d "$cache" ] && return 0
  local next="$cache.tmp.$$"
  rm -rf "$next"
  mkdir -p "$next" || return
  cp -r "$dir/compile.dest/classes" "$next/classes" || return
  cp "$java_home_file" "$next/java_home.txt" || return
  # A kept launcher names its own classes, so a query runs it as it is.
  sed "s|$dir/compile.dest/classes|$cache/classes|" "$launcher" > "$next/run" || return
  chmod +x "$next/run" || return
  # A rename, so a key's directory is whole once it exists; another checkout that kept it first wins.
  mv -T "$next" "$cache" 2>/dev/null || rm -rf "$next"
  echo "outline: kept the build as $key"
}

# A key's build was used: its stamp, for the cleanup, and for an MCP start the build it may begin from.
used() {
  touch "$base/$1/used"
  ln -sfn "$1" "$last.$$"
  mv -T "$last.$$" "$last"
}

# The background build an MCP start leaves behind it (see below): one at a time per checkout, its output
# in the log.
if [ "${1:-}" = --build-behind ]; then
  exec 9> "$lock"
  if ! flock -n 9; then
    note "background build: another is running in this checkout, so none is started"
    exit 0
  fi
  note "background build: started for $key in $here"
  status=0
  build_and_keep 2>&1 | while IFS= read -r line; do note "build: $line"; done || status=$?
  if [ "$status" -eq 0 ] && [ -d "$cache" ]; then
    used "$key"
    note "background build: done"
  else
    note "background build: failed, status $status"
  fi
  exit "$status"
fi

# What the query runs from: this key's build; for an MCP server whose key has none yet, the last build
# used, since a client gives a server about 30 s to answer `initialize` and a cold build takes a minute
# or two; else a build made first.
from="$cache"
if [ -d "$cache" ]; then
  used "$key"
elif [ "${1:-}" = mcp ] && [ -d "$last/" ] && [ -f "$last/run" ]; then
  from=$(readlink -f "$last")
  echo "outline: starting from the last build used, ${from##*/}, since these sources have none yet; theirs builds in the background for the next start" >&2
  note "starting from the last build used, ${from##*/}, since $key has none yet"
  touch "$from/used"
  # In its own session, so the client's ending this server's process group does not end the build.
  setsid "${BASH_SOURCE[0]}" --build-behind < /dev/null >> "$log" 2>&1 &
  note "background build: pid $!"
else
  # On stderr, so an MCP client's stdout stays JSON-RPC; the build is otherwise silent for its first minute or two.
  if [ "${1:-}" = mcp ]; then
    echo "outline: no build to start from, so the server waits for this one; a client may time out first" >&2
    note "no build to start from: building $key first"
  fi
  echo "outline: building the query tool first, since these sources have no build yet; a cold build takes a minute or two" >&2
  exec 9> "$lock"
  flock 9
  # Another query may have built it while this one waited.
  [ -d "$cache" ] || build_and_keep >&2
  exec 9>&-
  if [ ! -d "$cache" ]; then
    echo "outline: the build was not kept (a source changed during it); run the query again" >&2
    exit 2
  fi
  used "$key"
  note "built and kept $key"
fi

JAVA_HOME=$(cat "$from/java_home.txt")
export JAVA_HOME

# The MCP server runs from a copy of the classes, so that removing a key's build cannot reach a running
# server. The copy is named for this wrapper's pid, which lives as long as the server; snapshots of dead
# servers are removed at start.
if [ "${1:-}" = mcp ]; then
  snaps="$base/mcp"
  mkdir -p "$snaps"
  for old in "$snaps"/*; do
    [ -d "$old" ] || continue
    if ! kill -0 "${old##*/}" 2>/dev/null; then
      note "removing snapshot ${old##*/}: no process ${old##*/} is alive"
      rm -rf "$old"
    fi
  done
  snap="$snaps/$$"
  rm -rf "$snap"
  mkdir -p "$snap"
  trap 'st=$?; rm -rf "$snap"; note "ended with status $st before the server started"' EXIT
  cp -r "$from/classes" "$snap/classes"
  sed "s|$from/classes|$snap/classes|" "$from/run" > "$snap/run"
  chmod +x "$snap/run"
  # The server's stderr reaches the client as before and the log line by line; stdout stays the JSON-RPC.
  exec 3> >(while IFS= read -r line; do
    printf '%s\n' "$line" >&2
    note "stderr: $line"
  done)
  stamper=$!
  # An asynchronous command reads /dev/null for stdin unless redirected, so the server gets stdin explicitly.
  "$snap/run" --root "$root" "$@" <&0 2>&3 &
  child=$!
  note "started: server pid $child, build ${from##*/}, snapshot $snap"
  by=""
  for s in INT TERM HUP; do trap "by=SIG$s; kill \"\$child\" 2>/dev/null" "$s"; done
  status=0
  # A trapped signal interrupts `wait`; the server is waited for again, so its own status is the one logged.
  wait "$child" || status=$?
  if [ -n "$by" ]; then status=0; wait "$child" 2>/dev/null || status=$?; fi
  if [ -n "$by" ]; then how="the wrapper got $by and passed it on"
  elif [ "$status" -gt 128 ]; then how="the server was killed by SIG$(kill -l $((status - 128)) 2>/dev/null || echo "$((status - 128))")"
  else how="the server exited by itself (its last stderr line says why: stdin closed, or a request's failure)"; fi
  exec 3>&-
  wait "$stamper" 2>/dev/null || true
  trap 'rm -rf "$snap"; note "ended: server pid $child, status $status; $how"' EXIT
  exit "$status"
fi

exec "$from/run" --root "$root" "$@"
