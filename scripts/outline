#!/usr/bin/env bash
# The outline tool's `show` query, run from the caller's checkout (grit's TASTy query tool, dev/outline).
# Mill builds a launcher only when it is missing or a source is newer; the launcher's JAVA_HOME is the
# JDK build.mill pins, cached beside it so a query never waits on Mill.
#
# The build runs without a daemon in its own output directory, out/outline. Built in out/ itself, a
# no-daemon run replaces the compiler worker that out/'s warm daemon is connected to (Mill keeps one
# per JDK under out/mill.javalib.JvmWorkerModule) and takes it down when it exits, so that daemon's
# next compile fails with "Connection refused" until `./mill shutdown`. outline's Mill layout skips
# out/outline, as it does any nested Mill output directory.
#
#   scripts/outline show Moves.ask
#   scripts/outline show Ask.score --depth 2
set -euo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
root=$(git rev-parse --show-toplevel 2>/dev/null || echo "$here")

dir="$here/out/outline/grit/outline"
launcher="$dir/launcher.dest/run"
java_home_file="$dir/java_home.txt"

build_mill() { (cd "$here" && MILL_OUTPUT_DIR=out/outline ./mill --no-daemon --ticker false "$@"); }

# `show` prints a PathRef, "ref:v0:<hash>:<path>"; the path is everything after the third colon.
path_of() { build_mill show "$1" | tail -1 | tr -d '"' | cut -d: -f4-; }

# What an MCP server runs from, and its log, live outside out/, in a cache directory for this checkout:
# `./mill clean` removes out/outline whole, and a server whose classes went with it fails on the first
# class it had not yet loaded.
cache="${XDG_CACHE_HOME:-$HOME/.cache}/grit-outline/$(printf '%s' "$here" | sha256sum | cut -c1-12)"

# An MCP server's life goes to mcp.log in the cache: who started it, the server's stderr, what removed
# which snapshot, and how it ended. The client shows a server's stderr only when it fails to connect, so a
# server that dies later says why nowhere else. The log is cut to its last 2000 lines at each start.
log="$cache/mcp.log"
note() { :; }
if [ "${1:-}" = mcp ] || [ "${1:-}" = --build-behind ]; then
  mkdir -p "$cache"
  note() { printf '%s [%s] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%S.%3NZ)" "$$" "$*" >> "$log"; }
fi
if [ "${1:-}" = mcp ]; then
  if [ -f "$log" ] && [ "$(wc -l < "$log")" -gt 2000 ]; then
    tail -n 2000 "$log" > "$log.$$" && mv "$log.$$" "$log"
  fi
  parent=$(tr '\0' ' ' < "/proc/$PPID/cmdline" 2>/dev/null || echo '?')
  parent=${parent% }
  note "invoked: root $root, parent $PPID ${parent:0:200}"
  for s in INT TERM HUP; do trap "note \"got SIG$s before the server started\"; exit $((128 + $(kill -l $s)))" "$s"; done
  trap 'st=$?; note "ended with status $st before the server started"' EXIT
fi

# Builds the launcher and its JAVA_HOME file; Mill's output goes to stdout. The returns are explicit, since
# a caller testing the status turns `set -e` off inside.
build_launcher() {
  build_mill grit.outline.launcher || return
  # Mill rewrites the launcher only when a source's content changed; a source merely touched (a checkout,
  # a branch switch) would otherwise stay newer than it and send every query back through Mill.
  touch "$launcher" || return
  mkdir -p "$dir" || return
  path_of grit.outline.javaHome > "$java_home_file.$$" || return
  mv "$java_home_file.$$" "$java_home_file"
}

# The last good build, for an MCP server to start from at once while a newer launcher builds: `good` is a
# link to a good.<epoch>.<pid> directory holding the launcher (run), its classes and java_home.txt. The link
# is replaced by a rename, and the build before is kept, since a server starting may still be copying it.
good="$cache/good"
save_good() {
  local next
  next="$cache/good.$(date +%s).$$"
  mkdir -p "$next"
  cp -r "$dir/compile.dest/classes" "$next/classes"
  cp "$java_home_file" "$next/java_home.txt"
  cp "$launcher" "$next/run"
  ln -sfn "${next##*/}" "$good.$$"
  mv -T "$good.$$" "$good"
  local old
  for old in $(find "$cache" -maxdepth 1 -name 'good.*.*' -type d -printf '%f\n' | sort | head -n -2); do
    rm -rf "${cache:?}/$old"
  done
  note "saved the launcher as the last good build, ${next##*/}"
}

# The background build an MCP server's start leaves behind it (see below): one at a time per checkout, its
# output in the log, its result saved as the last good build.
if [ "${1:-}" = --build-behind ]; then
  exec 9> "$cache/build.lock"
  if ! flock -n 9; then
    note "background build: another is running, so none is started"
    exit 0
  fi
  note "background build: started"
  status=0
  build_launcher 2>&1 | while IFS= read -r line; do note "build: $line"; done || status=$?
  if [ "$status" -eq 0 ]; then
    save_good
    note "background build: done"
  else
    note "background build: failed, status $status"
  fi
  exit "$status"
fi

# Why the launcher must be built first, if it must: it is missing, or a source is newer than it.
why=""
if [ ! -f "$launcher" ] || [ ! -f "$java_home_file" ]; then
  why="it is not built yet"
else
  newer=$(find "$here/dev/outline/src" -name '*.scala' -newer "$launcher" -print -quit)
  if [ -n "$newer" ]; then why="${newer#"$here"/} is newer than it"; fi
fi

# What the query runs from: the launcher, or for an MCP server whose launcher is not ready, the last good
# build. A client gives a server about 30 s to answer `initialize`, and a cold build takes a minute or two.
run_from="$launcher"
classes_from="$dir/compile.dest/classes"
java_home_from="$java_home_file"
if [ -n "$why" ] && [ "${1:-}" = mcp ] && [ -d "$good/" ]; then
  last=$(readlink -f "$good")
  echo "outline: starting from the last good build, since the launcher $why; a new one builds in the background for the next start" >&2
  note "starting from the last good build ${last##*/}, since the launcher $why"
  run_from="$last/run"
  classes_from="$last/classes"
  java_home_from="$last/java_home.txt"
  # In its own session, so the client's ending this server's process group does not end the build.
  setsid "${BASH_SOURCE[0]}" --build-behind < /dev/null >> "$log" 2>&1 &
  note "background build: pid $!"
elif [ -n "$why" ]; then
  # On stderr, so an MCP client's stdout stays JSON-RPC; the build is otherwise silent for its first minute or two.
  if [ "${1:-}" = mcp ]; then
    echo "outline: no last good build to start from, so the server waits for this one; a client may time out first" >&2
    note "no last good build to start from: building the launcher first, since $why"
  fi
  echo "outline: building the query tool first, since $why; a cold build takes a minute or two" >&2
  build_launcher >&2
  note "built the launcher"
  if [ "${1:-}" = mcp ]; then save_good; fi
elif [ "${1:-}" = mcp ] && { [ ! -d "$good/" ] || [ "$launcher" -nt "$good/run" ]; }; then
  save_good
fi

JAVA_HOME=$(cat "$java_home_from")
export JAVA_HOME

# The MCP server runs from a copy of the classes, in the cache. A query rebuilds compile.dest/classes in
# place, and a JVM that has loaded a class of the old build then fails on one it loads from the new. The
# copy is named for this wrapper's pid, which lives as long as the server; snapshots of dead servers are
# removed at start.
if [ "${1:-}" = mcp ]; then
  snaps="$cache/mcp"
  mkdir -p "$snaps"
  for old in "$snaps"/*; do
    [ -d "$old" ] || continue
    if ! kill -0 "${old##*/}" 2>/dev/null; then
      note "removing snapshot ${old##*/}: no process ${old##*/} is alive"
      rm -rf "$old"
    fi
  done
  snap="$snaps/$$"
  rm -rf "$snap"
  mkdir -p "$snap"
  trap 'st=$?; rm -rf "$snap"; note "ended with status $st before the server started"' EXIT
  cp -r "$classes_from" "$snap/classes"
  # A launcher names its classes by the path Mill built them at, a last good build's too.
  sed "s|$dir/compile.dest/classes|$snap/classes|" "$run_from" > "$snap/run"
  chmod +x "$snap/run"
  # The server's stderr reaches the client as before and the log line by line; stdout stays the JSON-RPC.
  exec 3> >(while IFS= read -r line; do
    printf '%s\n' "$line" >&2
    note "stderr: $line"
  done)
  stamper=$!
  # An asynchronous command reads /dev/null for stdin unless redirected, so the server gets stdin explicitly.
  "$snap/run" --root "$root" "$@" <&0 2>&3 &
  child=$!
  note "started: server pid $child, snapshot $snap"
  by=""
  for s in INT TERM HUP; do trap "by=SIG$s; kill \"\$child\" 2>/dev/null" "$s"; done
  status=0
  # A trapped signal interrupts `wait`; the server is waited for again, so its own status is the one logged.
  wait "$child" || status=$?
  if [ -n "$by" ]; then status=0; wait "$child" 2>/dev/null || status=$?; fi
  if [ -n "$by" ]; then how="the wrapper got $by and passed it on"
  elif [ "$status" -gt 128 ]; then how="the server was killed by SIG$(kill -l $((status - 128)) 2>/dev/null || echo "$((status - 128))")"
  else how="the server exited by itself (its last stderr line says why: stdin closed, or a request's failure)"; fi
  exec 3>&-
  wait "$stamper" 2>/dev/null || true
  trap 'rm -rf "$snap"; note "ended: server pid $child, status $status; $how"' EXIT
  exit "$status"
fi

exec "$run_from" --root "$root" "$@"
