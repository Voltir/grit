//| mill-separate-bsp-output-dir: true
//| bspScriptIgnore: ["**/.local/"]
// Metals gets its own build directory (.bsp/out) and a foreground BSP JVM per connection,
// which exits when Metals closes its stdin; docs/editor-tooling.md. BSP otherwise offers
// every loose .scala file outside a module's sources as a single-file script module, so
// the vendored examples under .local/ were compiled, and failed, on every import.
package build
import mill.*, scalalib.*, scalalib.publish.*

trait GritModule extends ScalaModule {
  def scalaVersion = "3.9.0"

  /* Separation checking makes `grit.core.durable.Durable` exclusive: a step body that captures the
   * `Durable` it runs on (a nested step) is a compile error. See ADR 0003. */
  def separationChecking: Boolean = true

  // See STYLE.md
  def scalacOptions = Seq(
    "-no-indent",
    "-language:experimental.captureChecking",
    "-deprecation",
    "-feature",
    "-Wunused:all"
  ) ++ Option.when(separationChecking)("-language:experimental.separationChecking")

  /* JDK 24 warns on every sun.misc.Unsafe call; Scala 3's LazyVals$ still
   * uses objectFieldOffset, so the warning is spurious and not ours to fix. */
  def forkArgs = Seq("--sun-misc-unsafe-memory-access=allow")

  def javaHome = Task {
    sys.env
      .get("GRIT_JDK_HOME")
      .orElse(Some("/home/nickchilders/.jdks/jdk-26.0.2"))
      .filter(p => os.exists(os.Path(p)))
      .map(p => PathRef(os.Path(p)))
  }

  /* Every module's tests: utest, forked with the module's own JVM flags.
   *
   * Scala 3.9's -Wunused reports every pattern variable read only inside utest's `assert`
   * macro as unused -- ~85 false positives across the tui suite, checked by hand. Silenced
   * for tests only; main sources keep the full check. */
  trait GritTests extends ScalaTests {
    def forkArgs = Task { GritModule.this.forkArgs() }
    def testFramework = "utest.runner.Framework"
    def mvnDeps = Seq(mvn"com.lihaoyi::utest:0.9.5")
    def scalacOptions = Task { super.scalacOptions() ++ Seq("-Wconf:msg=unused pattern variable:s") }
  }
}

/* A module a deployment outside grit compiles against (ADR 0021): `./mill __.publishLocal`
 * writes each to the local ivy repository (~/.ivy2/local/dev.grit/grit-<module>_3). Every
 * module the kit reaches, and grit.slack for a deployment that serves Slack; never grit.tui,
 * grit.edge or grit.app. A -SNAPSHOT version, republished in place: nothing is released. */
trait GritPublished extends GritModule with PublishModule {
  def publishVersion = "0.1.0-SNAPSHOT"
  def pomSettings = PomSettings(
    description = "grit, an LLM agent harness: " + artifactName(),
    organization = "dev.grit",
    url = "",
    licenses = Seq(),
    versionControl = VersionControl(),
    developers = Seq()
  )
}

/* An integration test module (`it`): its suites run against a live Postgres, so they are
 * kept out of `./mill __.test` and run as `scripts/it` (`./mill __.it` under one shared
 * server). The tag is read from docker-compose.yml and the image is built from the
 * Dockerfile compose builds, so the tests and the dev database run the same Postgres
 * (TestPostgres).
 *
 * One JVM per module: Mill's default test parallelism forks a JVM per worker, and each
 * started its own container -- six in one full run, on a 4-CPU machine. */
trait LivePostgres extends TestModule {
  def testParallelism = Task { false }

  /* The server scripts/it started, as host:port; unset, each JVM starts its own. An input,
   * so every run reads the shell's value afresh: the Mill daemon keeps its own environment. */
  def sharedPostgres = Task.Input { Task.env.get("GRIT_TEST_POSTGRES") }


  def composeFile = Task.Source(mill.api.BuildCtx.workspaceRoot / "docker-compose.yml")
  def postgresDockerfile =
    Task.Source(mill.api.BuildCtx.workspaceRoot / "docker" / "postgres" / "Dockerfile")

  def postgresImage = Task {
    "(?m)^\\s*image:\\s*(grit-postgres:\\S+)".r
      .findFirstMatchIn(os.read(composeFile().path))
      .map(_.group(1))
      .getOrElse(sys.error("docker-compose.yml names no grit-postgres image"))
  }

  def forkEnv = Task {
    super.forkEnv() ++ Map(
      "GRIT_POSTGRES_IMAGE" -> postgresImage(),
      "GRIT_POSTGRES_DOCKERFILE" -> postgresDockerfile().path.toString
    ) ++ sharedPostgres().map("GRIT_TEST_POSTGRES" -> _)
  }
}

object grit extends Module {
  /* The domain and its seams. Names no other module, and has neither DBOS nor a JDBC
   * driver on its classpath -- STYLE rule 8's dev.dbos.* half is a compile error here. */
  object core extends GritPublished {

    def mvnDeps = Seq(
      mvn"com.lihaoyi::upickle:4.4.3"
    )

    object test extends GritTests {
      def mvnDeps = Task {
        super.mvnDeps() ++ Seq(mvn"org.scala-lang::scala3-compiler:${scalaVersion()}")
      }

      /* SeparationTests compiles probe sources against core, with core's own flags, to pin
       * what the compiler rejects (ADR 0003). */
      def forkEnv = Task {
        super.forkEnv() ++ Map(
          "GRIT_PROBE_CLASSPATH" -> core.runClasspath().map(_.path.toString).mkString(":"),
          "GRIT_PROBE_OPTIONS" -> core.scalacOptions().mkString(" ")
        )
      }
    }
  }

  /* The DBOS quarantine module (STYLE rule 8): everything that touches DBOS, JDBC or
   * Postgres, translated into grit-style capabilities before it leaves. */
  object dbos extends GritPublished {
    def moduleDeps = Seq(core)

    def mvnDeps = Seq(
      /* On an upgrade, run grit.dbos.test: CrashFidelityTests pins the two DBOSExecutor
       * internals DbosDurableTests' in-process crash relies on. */
      mvn"dev.dbos:transact:1.0.0",
      mvn"org.slf4j:slf4j-simple:2.0.20",
      mvn"org.postgresql:postgresql:42.7.13"
    )

    /* What needs no Postgres: configuration and codecs. */
    object test extends GritTests

    /* Live tests against a throwaway Postgres (`TestPostgres`), and core's store and durable
     * contracts run against the SQL stores and DBOS. */
    object it extends GritTests with LivePostgres {
      def moduleDeps = super.moduleDeps ++ Seq[JavaModule](grit.core.test)
      def mvnDeps = Task {
        super.mvnDeps() ++ Seq(mvn"org.testcontainers:testcontainers-postgresql:2.0.5")
      }
      /* CrashFidelityTests halts a child JVM, on this classpath, inside a step. */
      def forkEnv = Task {
        super.forkEnv() ++ Map(
          "GRIT_TEST_CLASSPATH" -> runClasspath().map(_.path.toString).mkString(":"),
          "GRIT_TEST_JAVA" -> javaHome().map(_.path / "bin" / "java").fold("java")(_.toString),
          "GRIT_TEST_FORK_ARGS" -> forkArgs().mkString(" ")
        )
      }
    }
  }

  /* Durable turn: the per-turn workflow, written against core's seams, not DBOS.
   * roadmap/mechanisms/durable-turn.md. */
  object turn extends GritPublished {
    def moduleDeps = Seq(core)

    /* The turn under core's in-memory durability and store fakes, with the stub provider
     * and the linear assembler: a provider called once, without Postgres. */
    object test extends GritTests {
      def moduleDeps = super.moduleDeps ++ Seq[JavaModule](grit.core.test, grit.assembly, grit.models)
      def mvnDeps = Task {
        super.mvnDeps() ++ Seq(
          mvn"com.lihaoyi::os-lib:0.11.8",
          mvn"org.scala-lang::scala3-compiler:${scalaVersion()}"
        )
      }

      /* Recorded turn histories, one directory per epoch (ADR 0004): TurnReplayTests
       * replays them, RecordTurnHistories and scripts/capture-history.sh write them. Their
       * content signature rides in the environment, read by no test, so that `testCached`
       * reruns when a history is added or changed: Mill invalidates on an input's output,
       * and the directory's path alone never changes.
       * TurnCaptureTests compiles probe sources against turn, with turn's own flags. */
      def histories = Task.Source(moduleDir / "histories")
      def forkEnv = Task {
        super.forkEnv() ++ Map(
          "GRIT_HISTORIES" -> histories().path.toString,
          "GRIT_HISTORIES_SIG" -> histories().sig.toString,
          "GRIT_PROBE_CLASSPATH" -> turn.runClasspath().map(_.path.toString).mkString(":"),
          "GRIT_PROBE_OPTIONS" -> turn.scalacOptions().mkString(" ")
        )
      }
    }
  }

  /* The engine's own workflows besides the turn: close (a period sealed with its closing
   * entry; ADR 0011). Written against core's seams and Durable, never DBOS, so its tests
   * run it over core's in-memory fakes. grit/lifecycle/README.md. */
  object lifecycle extends GritPublished {
    def moduleDeps = Seq(core)

    /* The close under core's in-memory durability and store fakes. Recorded close
     * histories, one directory per epoch (ADR 0004), are replayed by CloseReplayTests and
     * written by RecordCloseHistories, as grit.turn.test's are; the epoch is the engine's,
     * Turn.Epoch, which is all this reads of grit.turn. */
    object test extends GritTests {
      def moduleDeps = super.moduleDeps ++ Seq[JavaModule](grit.core.test, grit.turn)
      def mvnDeps = Task { super.mvnDeps() ++ Seq(mvn"com.lihaoyi::os-lib:0.11.8") }
      def histories = Task.Source(moduleDir / "histories")
      def forkEnv = Task {
        super.forkEnv() ++ Map(
          "GRIT_HISTORIES" -> histories().path.toString,
          "GRIT_HISTORIES_SIG" -> histories().sig.toString
        )
      }
    }
  }

  /* Digest: the hello-world plugin, one line per closed period, and the recent_activity
   * tool that reads them. Names only core. grit/digest/README.md. */
  object digest extends GritPublished {
    def moduleDeps = Seq(core)

    /* Over core's in-memory plugin store. */
    object test extends GritTests {
      def moduleDeps = super.moduleDeps ++ Seq[JavaModule](grit.core.test)
    }
  }

  /* Models: the frontier provider, and later the relevance judge. A quarantine module
   * once it has an HTTP client. roadmap/mechanisms/models.md. */
  object models extends GritPublished {
    def moduleDeps = Seq(core)

    object test extends GritTests {
      def moduleDeps = super.moduleDeps ++ Seq[JavaModule](grit.core.test)
    }
  }

  /* The local host: grit.core.host's Workspace, Edits and Shell over this machine's files
   * and processes, in a checkout. The only module that starts a process (enola-intent.yaml). */
  object host extends GritPublished {
    def moduleDeps = Seq(core)

    /* Against a temporary directory, and `sh` for the shell. */
    object test extends GritTests
  }

  /* The coding tool set: read, list, search, write, edit and run, as grit.core.tool Tools
   * over grit.core.host's capabilities. Names no implementation of them. */
  object tools extends GritPublished {
    def moduleDeps = Seq(core)

    object test extends GritTests
  }

  /* The edge's side of the engine: what an edge does for a place it hosts, over core's
   * traits alone. Names no implementation of them; grit.app hands it grit.host's. */
  object edge extends GritModule {
    def moduleDeps = Seq(core)

    object test extends GritTests {
      def moduleDeps = super.moduleDeps ++ Seq[JavaModule](grit.core.test)
    }
  }

  /* The Slack edge (ADR 0019): the Slack SDK's quarantine (STYLE rule 8), and the edge that
   * brings Slack threads in and posts grit's replies out, over core's traits alone. The SDK
   * is slack-api-client, without Bolt: grit acknowledges an event only after it is recorded,
   * and wants the transport alone. Its Socket Mode WebSocket backend is Java-WebSocket, a
   * `provided` dependency of the SDK, at the version its parent POM pins.
   * grit/slack/README.md. */
  object slack extends GritPublished {
    def moduleDeps = Seq(core, prose)
    def mvnDeps = Seq(
      mvn"com.slack.api:slack-api-client:1.51.0",
      mvn"org.java-websocket:Java-WebSocket:1.6.0"
    )

    object test extends GritTests {
      def moduleDeps = super.moduleDeps ++ Seq[JavaModule](grit.core.test)
    }
  }

  /* Assembly: builds each turn's context window from memory.
   * roadmap/mechanisms/assembly.md. */
  object assembly extends GritPublished {
    def moduleDeps = Seq(core)

    /* The assemblers over core's in-memory store. */
    object test extends GritTests {
      def moduleDeps = super.moduleDeps ++ Seq[JavaModule](grit.core.test)
    }
  }

  /* The assembly eval: every assembler over the same labelled cases, in a throwaway
   * Postgres so retrieval ranks with the real pg_textsearch. Integration sources only; a
   * report, not a gate. roadmap/mechanisms/assembly-eval.md. */
  object eval extends GritModule {
    def moduleDeps = Seq(grit.core, grit.dbos, grit.assembly, grit.models)

    object it extends GritTests with LivePostgres {
      def moduleDeps = super.moduleDeps ++ Seq[JavaModule](grit.dbos.it)
    }
  }

  /* Prose: a reply's structure as edge-neutral blocks (the form), read from markdown.
   * Names no other module; each edge renders the form its own way. grit/prose/README.md. */
  object prose extends GritPublished {
    object test extends GritTests
  }

  /* The terminal UI -- ported from ../Spikes/tui-spike-slate. No external dependencies:
   * the terminal seam is hand-rolled over FFM (grit/tui/src/wire/term), not JLine. It may
   * render core's types, but only from `components` and `runtime`; see grit/tui/CLAUDE.md. */
  object tui extends GritModule {
    def moduleDeps = Seq(core)

    /* The terminal seam binds tcgetattr/tcsetattr/ioctl/isatty with FFM. Unflagged, each
     * downcall prints a restricted-method WARNING to stderr -- which for an app holding the
     * alternate screen lands in the middle of the frame -- and JEP 472 will block them
     * outright in a later release. */
    def forkArgs = Task { super.forkArgs() ++ Seq("--enable-native-access=ALL-UNNAMED") }

    /* Off here only: the FFM terminal seam is byte arrays handed to Java, which separation
     * checking treats as Mutable and Java signatures demand pure. tui never holds a
     * `Durable` (ADR 0002), so nothing ADR 0003 protects is compiled here. */
    def separationChecking = false

    object test extends GritTests {
      /* NodeCaptureTests compiles probe sources against tui with tui's own flags, as
       * grit.core.durable.SeparationTests does, to pin what capture checking rejects in a view
       * tree's handlers and apps. */
      def mvnDeps = Task {
        super.mvnDeps() ++ Seq(mvn"org.scala-lang::scala3-compiler:${scalaVersion()}")
      }
      def forkEnv = Task {
        super.forkEnv() ++ Map(
          "GRIT_PROBE_CLASSPATH" -> tui.runClasspath().map(_.path.toString).mkString(":"),
          "GRIT_PROBE_OPTIONS" -> tui.scalacOptions().mkString(" ")
        )
      }
    }

    /* Everything runnable, so the library carries no demo baggage. Demo is the pty gate's
     * target (scripts/tui-gate) for the features grit.app's screen does not use. */
    object examples extends GritModule {
      def moduleDeps = Seq(tui)
      def forkArgs = Task { tui.forkArgs() }
      def separationChecking = false
      def mainClass = Some("grit.tui.examples.Hello")
    }
  }

  /* The kit a deployment is built against (ADR 0021): the Deployment value, what the
   * environment supplies, and the runner that serves a deployment's edges beside its engine.
   * Names no edge extension and no terminal UI: an edge arrives as a ServedEdge value.
   * grit/kit/README.md. */
  object kit extends GritPublished {
    def moduleDeps =
      Seq(
        grit.core,
        grit.dbos,
        grit.turn,
        grit.lifecycle,
        grit.assembly,
        grit.models,
        grit.tools,
        grit.digest,
        grit.host
      )

    object test extends GritTests {
      def moduleDeps = super.moduleDeps ++ Seq[JavaModule](grit.core.test)
    }
  }

  /* The reference deployment: grit's own chat, `grit serve` and `grit backfill`, filled from
   * GRIT_* variables and run through the kit. The only module that sees every module. */
  object app extends GritModule {
    def moduleDeps =
      Seq(
        grit.kit,
        grit.prose,
        grit.tui,
        grit.host,
        grit.edge,
        grit.slack
      )
    def forkArgs = Task { tui.forkArgs() }
    def mainClass = Some("grit.app.main.Main")

    object test extends GritTests

    /* A provider called once, end to end and live. The crash test runs one phase in a child JVM on this
     * classpath, which it halts mid-turn. */
    object it extends GritTests with LivePostgres {
      def moduleDeps = super.moduleDeps ++ Seq[JavaModule](grit.dbos.it, grit.slack.test)
      def mvnDeps = Task { super.mvnDeps() ++ Seq(mvn"com.lihaoyi::os-lib:0.11.8") }
      def forkEnv = Task {
        super.forkEnv() ++ Map(
          "GRIT_TEST_CLASSPATH" -> runClasspath().map(_.path.toString).mkString(":"),
          "GRIT_TEST_JAVA" -> javaHome().map(_.path / "bin" / "java").fold("java")(_.toString)
        )
      }
    }
  }
}

