package build
import mill.*, scalalib.*

trait GritModule extends ScalaModule {
  def scalaVersion = "3.8.4"

  // See STYLE.md
  def scalacOptions = Seq(
    "-no-indent",
    "-language:experimental.captureChecking",
    "-deprecation",
    "-feature",
    "-Wunused:all"
  )

  /* JDK 24 warns on every sun.misc.Unsafe call; Scala 3.8.4's LazyVals$ still
   * uses objectFieldOffset, so the warning is spurious and not ours to fix. */
  def forkArgs = Seq("--sun-misc-unsafe-memory-access=allow")

  def javaHome = Task {
    sys.env
      .get("GRIT_JDK_HOME")
      .orElse(Some("/home/nickchilders/.jdks/jdk-26.0.2"))
      .filter(p => os.exists(os.Path(p)))
      .map(p => PathRef(os.Path(p)))
  }
}

object grit extends Module {
  object core extends GritModule {

    def mvnDeps = Seq(
      mvn"dev.dbos:transact:1.0.0",
      mvn"org.slf4j:slf4j-simple:2.0.18",
      mvn"org.postgresql:postgresql:42.7.4",
      mvn"com.lihaoyi::upickle:4.0.2"
    )

    object test extends ScalaTests {
      def forkArgs = Task { core.forkArgs() }
      def testFramework = "utest.runner.Framework"

      def mvnDeps = Seq(mvn"com.lihaoyi::utest:0.8.4")
    }
  }

  object tui extends GritModule {

    def mvnDeps = Seq(
      mvn"org.jline:jline:4.4.1"
    )

    object test extends ScalaTests {
      def forkArgs = Task { tui.forkArgs() }
      def testFramework = "utest.runner.Framework"

      def mvnDeps = Seq(mvn"com.lihaoyi::utest:0.8.4")
    }
  }
}

