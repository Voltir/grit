# enola: the pinned binary, and the snapshot/baseline it writes.
# `.enola/*` with a star, not a slash: git will not descend into an ignored
# directory, so a slash form makes the negation below unreachable.
tools/enola
.enola/*
!.enola/suppressions.yaml
**/.enola/*

# Claude Code: shared config is tracked, machine-local permissions are not.
.claude/settings.local.json
