# Copy to .env (gitignored) and fill in what you need. grit.app reads it at startup; a
# variable set in the real environment wins. Tests never read it.

# The model. Unset: the stub, which calls nothing and costs nothing.
OPENROUTER_API_KEY=
# The stub answers each turn after this many milliseconds: a slow model, to watch for free.
# GRIT_STUB_DELAY_MS=0
# The model that answers, and its output budget.
# GRIT_MODEL=openai/gpt-oss-20b
# GRIT_MAX_TOKENS=4096
# The OpenRouter upstreams that may serve it, in order, with no fallback to others. Unset:
# any, with fallbacks. Whether its tool schemas are sent strict (needs upstreams; unset:
# false). Only some upstreams enforce strict, and a fallback loses it silently.
# GRIT_PROVIDER=open-inference/fp8
# GRIT_STRICT_TOOLS=false
# The model that writes each turn's summary. Unset: GRIT_MODEL.
# GRIT_SUMMARY_MODEL=openai/gpt-oss-20b
# GRIT_SUMMARY_MAX_TOKENS=1024
# Its upstreams and strictness, as the turn's. With none of its own three set, the turn's.
# GRIT_SUMMARY_PROVIDER=
# GRIT_SUMMARY_STRICT_TOOLS=false
# The model that writes retrieval's search queries. Unset: GRIT_MODEL.
# GRIT_QUERY_MODEL=openai/gpt-oss-20b
# GRIT_QUERY_MAX_TOKENS=1024
# GRIT_QUERY_PROVIDER=
# GRIT_QUERY_STRICT_TOOLS=false

# How many estimated tokens of earlier turns each turn's window may hold.
# GRIT_WINDOW_TOKENS=24000
# What chooses them: retrieval (the recent turns that fit in GRIT_TAIL_TOKENS, plus the
# earlier turns a written query finds) or linear (the recent turns alone).
# GRIT_ASSEMBLER=retrieval
# GRIT_TAIL_TOKENS=8000

# The tools each turn's model is offered over the checkout: read (read, list, search) or
# all (those, and write, edit and run, each of which the chat asks you to approve first).
# all needs the chat: a run with arguments refuses it.
# GRIT_TOOLS=read
# The most model calls a turn makes, the last with tools off; at least 2.
# GRIT_TOOL_ROUNDS=20

# The chat TUI's colours: frost (default), tokyo-night, tokyo-storm, tokyo-moon, abyss,
# nightshade.
# GRIT_THEME=frost

# The chat TUI's conversation, and where it logs.
# GRIT_SESSION=default
# GRIT_LOG=/tmp/grit-tui.log

# Postgres. Unset: the docker-compose database.
# GRIT_DATABASE_URL=jdbc:postgresql://localhost:5432/grit
# GRIT_DATABASE_USER=grit
# GRIT_DATABASE_PASSWORD=grit
