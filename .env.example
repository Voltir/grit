# Copy to .env (gitignored) and fill in what you need. grit.app reads it at startup; a
# variable set in the real environment wins. Tests never read it.

# The model. Unset: the stub, which calls nothing and costs nothing.
OPENROUTER_API_KEY=
# The model that answers, and its output budget.
# GRIT_MODEL=openai/gpt-oss-20b
# GRIT_MAX_TOKENS=4096
# The model that writes each turn's summary. Unset: GRIT_MODEL.
# GRIT_SUMMARY_MODEL=openai/gpt-oss-20b
# GRIT_SUMMARY_MAX_TOKENS=1024

# How many estimated tokens of earlier turns each turn's window may hold.
# GRIT_WINDOW_TOKENS=24000

# The chat TUI's conversation, and where it logs.
# GRIT_SESSION=default
# GRIT_LOG=/tmp/grit-tui.log

# Postgres. Unset: the docker-compose database.
# GRIT_DATABASE_URL=jdbc:postgresql://localhost:5432/grit
# GRIT_DATABASE_USER=grit
# GRIT_DATABASE_PASSWORD=grit
