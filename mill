#!/usr/bin/env sh
# Every Mill call in this checkout goes through here, and carries --use-file-locks.
#
# Mill's daemon, and the zinc worker behind it, are locked by default with a pid lock that
# stores the process's start time and demands it equal to the millisecond. The start time is
# read from /proc/stat's btime, which drifts on WSL2, so a later call decides no daemon is
# running and starts a second one, which deletes the first's socketPort: "server launch
# failed" (Mill issue 7782). --use-file-locks locks a file instead. It must be on every call:
# a flagged and an unflagged call in one out/ do not see each other's lock, which is the same
# breakage. Mill reads it only from the command line, before the tasks.
#
# The stock bootstrap is scripts/mill-bootstrap, unchanged, so a Mill upgrade replaces that
# file alone.
MILL_MAIN_CLI="${MILL_MAIN_CLI:-$0}" exec "$(dirname "$0")/scripts/mill-bootstrap" --use-file-locks "$@"
